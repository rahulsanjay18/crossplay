diff --git a/src/apps_local/xiangqi/XiangqiActivity.cpp b/src/apps_local/xiangqi/XiangqiActivity.cpp
new file mode 100644
index 00000000..9be2c346
--- /dev/null
+++ b/src/apps_local/xiangqi/XiangqiActivity.cpp
@@ -0,0 +1,494 @@
+#include "XiangqiActivity.h"
+
+#include <HalStorage.h>
+#include <Logging.h>
+#include <Memory.h>
+
+#include "../Shelf.h"
+#include "../ui/Toybox.h"
+#include "../ui/ToyboxFonts.h"
+#include "../ui/ToyboxTheme.h"
+#include "XiangqiSave.h"
+#include "XiangqiScreens.h"
+
+namespace xq = xiangqi;
+
+namespace {
+
+#if defined(ARDUINO_ARCH_ESP32) || defined(SIMULATOR)
+constexpr char kSavePath[] = "/.crosspoint/xiangqi.sav";
+constexpr char kSaveTempPath[] = "/.crosspoint/xiangqi.sav.tmp";
+#endif
+
+// Xiangqi branches less than shogi (no drops), so the same kind of budget buys
+// a ply more. Iterative: running out plays the deepest finished iteration.
+constexpr int kEngineDepth = 5;
+constexpr uint32_t kEngineNodes = 80000;
+
+}  // namespace
+
+std::unique_ptr<Activity> XiangqiActivity::create(GfxRenderer& renderer, MappedInputManager& mappedInput) {
+  return makeUniqueNoThrow<XiangqiActivity>(renderer, mappedInput);
+}
+
+void XiangqiActivity::onEnter() {
+  Activity::onEnter();
+  toybox::ensureFonts(renderer);
+  screen = xq::Screen::Menu;
+  xq::startGame(game);
+  refresh();
+  loadSave();
+  requestUpdate();
+}
+
+void XiangqiActivity::onExit() {
+  writeSave();
+  LinkActivity::onExit();
+}
+
+void XiangqiActivity::loadSave() {
+#if defined(ARDUINO_ARCH_ESP32) || defined(SIMULATOR)
+  canContinue = false;
+  if (!Storage.exists(kSavePath)) return;
+  char buffer[xiangqisave::kMaxLine + 8] = {};
+  if (Storage.readFileToBuffer(kSavePath, buffer, sizeof(buffer)) == 0) return;
+  xiangqisave::Save save;
+  if (!xiangqisave::unpack(buffer, save)) {
+    LOG_ERR("XIANGQI", "Ignoring an unreadable save");
+    return;
+  }
+  wins = save.wins;
+  losses = save.losses;
+  draws = save.draws;
+  if (save.inProgress) {
+    game = save.game;
+    opponent = save.opponent;
+    seat = save.seat;
+    refresh();
+    canContinue = cachedOutcome == xq::Outcome::Running;
+  }
+#endif
+}
+
+void XiangqiActivity::writeSave() {
+  if (inMatch()) return;
+#if defined(ARDUINO_ARCH_ESP32) || defined(SIMULATOR)
+  xiangqisave::Save save;
+  save.wins = wins;
+  save.losses = losses;
+  save.draws = draws;
+  save.inProgress = canContinue;
+  save.opponent = opponent;
+  save.seat = seat;
+  save.game = game;
+  char line[xiangqisave::kMaxLine];
+  if (xiangqisave::pack(save, line, sizeof(line)) <= 0) {
+    LOG_ERR("XIANGQI", "Save line did not fit %d bytes", static_cast<int>(sizeof(line)));
+    return;
+  }
+  Storage.writeFile(kSaveTempPath, String(line));
+  Storage.remove(kSavePath);
+  Storage.rename(kSaveTempPath, kSavePath);
+#endif
+}
+
+void XiangqiActivity::refresh() {
+  xq::generateLegal(game.board, legal);
+  cachedOutcome = xq::outcome(game);
+  cachedCheck = xq::inCheck(game.board, game.board.turn);
+}
+
+void XiangqiActivity::goTo(const xq::Screen next) {
+  screen = next;
+  requestUpdate();
+}
+
+void XiangqiActivity::clearPick() {
+  picked = xq::kNothingPicked;
+  targets.count = 0;
+}
+
+void XiangqiActivity::startGame(const xq::Opponent who) {
+  opponent = who;
+  seat = xq::kRed;
+  xq::startGame(game);
+  refresh();
+  clearPick();
+  resultRecorded = false;
+  engineThinking = false;
+  canContinue = true;
+  writeSave();
+  goTo(xq::Screen::Board);
+}
+
+void XiangqiActivity::resumeGame() {
+  clearPick();
+  resultRecorded = false;
+  engineThinking = engineToMove();
+  goTo(xq::Screen::Board);
+}
+
+bool XiangqiActivity::engineToMove() const {
+  return !inMatch() && opponent == xq::Opponent::Computer && game.board.turn != seat &&
+         cachedOutcome == xq::Outcome::Running;
+}
+
+bool XiangqiActivity::myMove() const {
+  if (cachedOutcome != xq::Outcome::Running || engineThinking) return false;
+  if (inMatch()) return linkYourTurn();
+  if (opponent == xq::Opponent::Friend) return true;
+  return game.board.turn == seat;
+}
+
+bool XiangqiActivity::won() const { return (cachedOutcome == xq::Outcome::RedWins) == (seat == xq::kRed); }
+
+const char* XiangqiActivity::statusText() const {
+  if (engineThinking || engineToMove()) return "THINKING";
+  if (inMatch() && !linkYourTurn()) return "THEIR MOVE";
+  if (opponent == xq::Opponent::Friend && !inMatch()) {
+    if (game.board.turn == xq::kRed) return cachedCheck ? "RED: CHECK" : "RED TO MOVE";
+    return cachedCheck ? "BLACK: CHECK" : "BLACK TO MOVE";
+  }
+  return cachedCheck ? "CHECK: YOUR MOVE" : "YOUR MOVE";
+}
+
+void XiangqiActivity::afterMove() {
+  clearPick();
+  refresh();
+  if (inMatch()) {
+    play.play(game);
+  } else {
+    canContinue = cachedOutcome == xq::Outcome::Running;
+    writeSave();
+    if (engineToMove()) engineThinking = true;
+  }
+  requestUpdate();
+}
+
+void XiangqiActivity::handlePoint(const int point) {
+  if (!myMove()) return;
+  if (picked != xq::kNothingPicked) {
+    xq::Move move{};
+    if (xq::moveBetween(legal, picked, point, move)) {
+      if (xq::play(game, move)) afterMove();
+      return;
+    }
+  }
+  if (xq::canPick(legal, point) && point != picked) {
+    picked = point;
+    xq::targetsFor(game.board, legal, point, targets);
+    requestUpdate();
+    return;
+  }
+  if (picked != xq::kNothingPicked) {
+    clearPick();
+    requestUpdate();
+  }
+}
+
+void XiangqiActivity::playEngineMove() {
+  engineThinking = false;
+  const xq::SearchResult result = xq::search(game.board, kEngineDepth, searchBuffers, kEngineNodes);
+  LOG_DBG("XIANGQI", "engine: %u nodes, depth %d, score %d%s", static_cast<unsigned>(result.nodes),
+          result.depthCompleted, result.score, result.budgetExhausted ? " (budget hit)" : "");
+  if (!result.hasMove) {
+    refresh();
+    requestUpdate();
+    return;
+  }
+  if (xq::play(game, result.best)) afterMove();
+}
+
+void XiangqiActivity::recordResult() {
+  if (resultRecorded) return;
+  resultRecorded = true;
+  canContinue = false;
+  if (opponent == xq::Opponent::Friend && !inMatch()) {
+    writeSave();
+    return;
+  }
+  if (cachedOutcome == xq::Outcome::Draw) {
+    ++draws;
+  } else if (won()) {
+    ++wins;
+  } else {
+    ++losses;
+  }
+  if (!inMatch()) writeSave();
+}
+
+const char* XiangqiActivity::linkHeadline() const {
+  if (linkPhase() == linkplay::PlayBase::Phase::Searching) return "LOOKING FOR A PLAYER";
+  if (cachedOutcome == xq::Outcome::Running) return "XIANGQI";
+  if (cachedOutcome == xq::Outcome::Draw) return "A DRAW";
+  return won() ? "YOU WIN" : "THEY WIN";
+}
+
+void XiangqiActivity::onMatchStart(const bool goesFirst) {
+  // Red moves first, so whoever goes first IS Red. Both sides set up the fixed
+  // opening: a zeroed Game has no generals and would read as finished.
+  seat = goesFirst ? xq::kRed : xq::kBlack;
+  xq::startGame(game);
+  refresh();
+  clearPick();
+  resultRecorded = false;
+  engineThinking = false;
+  goTo(xq::Screen::Board);
+}
+
+bool XiangqiActivity::takeOpponentState() {
+  const bool took = play.takeOpponent(game);
+  if (took) {
+    clearPick();
+    refresh();
+  }
+  return took;
+}
+
+void XiangqiActivity::onRematch() { onMatchStart(play.goesFirst()); }
+
+void XiangqiActivity::onLinkEnded() {
+  // See ShogiActivity::onLinkEnded: the match's result is kept across the
+  // reload of the solo save, and written now that writeSave() will allow it.
+  const int keptWins = wins;
+  const int keptLosses = losses;
+  const int keptDraws = draws;
+  seat = xq::kRed;
+  clearPick();
+  xq::startGame(game);
+  refresh();
+  loadSave();
+  wins = keptWins;
+  losses = keptLosses;
+  draws = keptDraws;
+  writeSave();
+  goTo(xq::Screen::Menu);
+}
+
+void XiangqiActivity::onMatchEnded() {
+  recordResult();
+  goTo(xq::Screen::Result);
+}
+
+uint32_t XiangqiActivity::surfaceMeaning() const {
+  uint32_t meaning = paintclock::mixMeaning(paintclock::kMeaningSeed, static_cast<uint32_t>(screen));
+  meaning = paintclock::mixMeaning(meaning, seat);
+  return paintclock::mixMeaning(meaning, myMove() ? 1u : 0u);
+}
+
+void XiangqiActivity::gameLoop() {
+  namespace fui = freeink::ui;
+
+  if (mappedInput.wasReleased(MappedInputManager::Button::Back)) {
+    if (inMatch()) {
+      leaveLink();
+      return;
+    }
+    if (xq::leavesApp(screen)) {
+      writeSave();
+      shelf::leave(renderer, mappedInput);
+      return;
+    }
+    if (screen == xq::Screen::Board) {
+      engineThinking = false;
+      clearPick();
+      writeSave();
+    }
+    goTo(xq::back(screen));
+    return;
+  }
+
+  if (screen == xq::Screen::HowTo) {
+    const bool forward = mappedInput.wasReleased(MappedInputManager::Button::Down);
+    const bool backward = mappedInput.wasReleased(MappedInputManager::Button::Up);
+    if (forward || backward) {
+      const int pages = xiangqiui::howToPages();
+      howToPage = (howToPage + (forward ? 1 : pages - 1)) % pages;
+      requestUpdate();
+      return;
+    }
+  }
+
+  if (screen == xq::Screen::Board) {
+    if (inMatch()) {
+      if (!linkYourTurn()) {
+        if (takeOpponentState()) requestUpdate();
+        return;
+      }
+    } else {
+      if (cachedOutcome != xq::Outcome::Running) {
+        recordResult();
+        goTo(xq::Screen::Result);
+        return;
+      }
+      if (engineThinking) {
+        playEngineMove();
+        return;
+      }
+      if (engineToMove()) {
+        engineThinking = true;
+        requestUpdate();
+        return;
+      }
+    }
+  }
+
+  fui::InputSnapshot input;
+  int tapX = 0;
+  int tapY = 0;
+  if (mappedInput.wasScreenTapped(tapX, tapY)) {
+    input.touchReleased = true;
+    input.touchX = static_cast<int16_t>(tapX);
+    input.touchY = static_cast<int16_t>(tapY);
+  }
+  if (!input.touchReleased || !interactionsReady) return;
+
+  if (screen == xq::Screen::Board) {
+    const fui::DeviceContext device = toybox::makeTarget(renderer).deviceContext();
+    int file = 0;
+    int rank = 0;
+    if (xiangqiui::pointAt(device, tapX, tapY, seat, file, rank)) {
+      // Ninety points do not fit the interaction table, so this tap never
+      // reaches route(). See Activity::surfaceMeaning().
+      if (!surfaceRevealed()) return;
+      handlePoint(xq::indexOf(file, rank));
+      return;
+    }
+  }
+
+  const fui::ActionEvent event = interactions.route(input);
+  switch (event.action) {
+    case xiangqiui::ActionMenuRow:
+      switch (static_cast<xiangqiui::MenuRow>(event.value)) {
+        case xiangqiui::MenuRow::Continue:
+          resumeGame();
+          return;
+        case xiangqiui::MenuRow::Computer:
+          startGame(xq::Opponent::Computer);
+          return;
+        case xiangqiui::MenuRow::Friend:
+          startGame(xq::Opponent::Friend);
+          return;
+        case xiangqiui::MenuRow::Nearby:
+          enterLink(linkplay::GameId::Xiangqi);
+          return;
+        case xiangqiui::MenuRow::HowTo:
+          howToPage = 0;
+          goTo(xq::Screen::HowTo);
+          return;
+        case xiangqiui::MenuRow::Count:
+          return;
+      }
+      return;
+
+    case xiangqiui::ActionHowToNext:
+      if (howToPage + 1 < xiangqiui::howToPages()) {
+        ++howToPage;
+        requestUpdate();
+        return;
+      }
+      goTo(xq::Screen::Menu);
+      return;
+
+    case xiangqiui::ActionAgain:
+      if (inMatch()) {
+        proposeRematch();
+        return;
+      }
+      startGame(opponent);
+      return;
+
+    case xiangqiui::ActionDone:
+      if (inMatch()) {
+        leaveLink();
+        return;
+      }
+      goTo(xq::Screen::Menu);
+      return;
+
+    default:
+      return;
+  }
+}
+
+void XiangqiActivity::gameRender() {
+  namespace fui = freeink::ui;
+
+  renderer.clearScreen();
+  fui::GfxRendererTarget target = toybox::makeTarget(renderer);
+  const fui::DeviceContext device = target.deviceContext();
+  const fui::InputSnapshot noInput{};
+  interactionsReady = false;
+  toybox::Frame frame(target, device, noInput, interactions);
+  toybox::Screen surface(frame);
+
+  switch (screen) {
+    case xq::Screen::Menu: {
+      xiangqiui::MenuModel model;
+      model.canContinue = canContinue;
+      model.wins = wins;
+      model.losses = losses;
+      model.draws = draws;
+      xiangqiui::buildMenu(surface, model);
+      break;
+    }
+    case xq::Screen::HowTo: {
+      xiangqiui::HowToModel model;
+      model.page = howToPage;
+      xiangqiui::buildHowTo(surface, model);
+      break;
+    }
+    case xq::Screen::Board: {
+      xiangqiui::BoardModel model;
+      model.board = game.board;
+      model.seat = seat;
+      model.picked = picked;
+      model.targets = targets;
+      model.lastTo = game.lastTo;
+      model.status = statusText();
+      model.opponentName = inMatch() ? opponentName() : nullptr;
+      xiangqiui::buildBoard(surface, model);
+      break;
+    }
+    case xq::Screen::Result: {
+      xiangqiui::ResultModel model;
+      const bool friendGame = opponent == xq::Opponent::Friend && !inMatch();
+      if (cachedOutcome == xq::Outcome::Draw) {
+        model.title = "A DRAW";
+      } else if (friendGame) {
+        model.title = cachedOutcome == xq::Outcome::RedWins ? "RED WINS" : "BLACK WINS";
+      } else {
+        model.title = won() ? "YOU WIN" : "THEY WIN";
+      }
+      switch (xq::endingOf(game, cachedOutcome)) {
+        case xq::Ending::Checkmate:
+          model.reason = "CHECKMATE";
+          break;
+        case xq::Ending::Stalemate:
+          model.reason = "NO LEGAL MOVES";
+          break;
+        case xq::Ending::Repetition:
+          model.reason = "THREE REPEATS";
+          break;
+        case xq::Ending::NoCaptures:
+          model.reason = "60 MOVES, NO CAPTURE";
+          break;
+        case xq::Ending::MoveLimit:
+          model.reason = "MOVE LIMIT";
+          break;
+        case xq::Ending::None:
+          break;
+      }
+      model.plies = game.plies;
+      xiangqiui::buildResult(surface, model);
+      break;
+    }
+  }
+
+  interactionsReady = true;
+  toybox::reportOverflow(interactions, "Xiangqi");
+
+  const auto labels = mappedInput.mapLabels("Back", "", "", "");
+  GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+  renderer.displayBuffer();
+}
diff --git a/src/apps_local/xiangqi/XiangqiActivity.h b/src/apps_local/xiangqi/XiangqiActivity.h
new file mode 100644
index 00000000..2cae8da6
--- /dev/null
+++ b/src/apps_local/xiangqi/XiangqiActivity.h
@@ -0,0 +1,85 @@
+#pragma once
+
+// Xiangqi on the device: the thin layer over the freestanding rules, engine,
+// flow and screens. Same three ways to play as Shogi -- the computer, a friend
+// on the same device, or a nearby device through LinkActivity.
+
+#include <memory>
+
+#include "../link/LinkActivity.h"
+#include "../ui/ToyboxScreen.h"
+#include "XiangqiCore.h"
+#include "XiangqiEngine.h"
+#include "XiangqiFlow.h"
+
+class XiangqiActivity final : public linkplay::LinkActivity {
+ public:
+  XiangqiActivity(GfxRenderer& renderer, MappedInputManager& mappedInput)
+      : linkplay::LinkActivity("Xiangqi", renderer, mappedInput) {}
+  ~XiangqiActivity() override = default;
+
+  static std::unique_ptr<Activity> create(GfxRenderer& renderer, MappedInputManager& mappedInput);
+
+  void onEnter() override;
+  void onExit() override;
+
+ protected:
+  linkplay::PlayBase& linkState() override { return play; }
+  const linkplay::PlayBase& linkState() const override { return play; }
+  const char* linkGameTitle() const override { return "XIANGQI"; }
+  const char* linkHeadline() const override;
+  void onMatchStart(bool goesFirst) override;
+  bool takeOpponentState() override;
+  void onRematch() override;
+  void onLinkEnded() override;
+  bool matchGameOver() const override { return cachedOutcome != xiangqi::Outcome::Running; }
+  void onMatchEnded() override;
+  void gameLoop() override;
+  void gameRender() override;
+
+ private:
+  void startGame(xiangqi::Opponent who);
+  void resumeGame();
+  void goTo(xiangqi::Screen next);
+  void clearPick();
+  void refresh();
+  void afterMove();
+  void handlePoint(int point);
+  void playEngineMove();
+  bool myMove() const;
+  bool engineToMove() const;
+  bool won() const;
+  const char* statusText() const;
+  void recordResult();
+  void loadSave();
+  void writeSave();
+
+  uint32_t surfaceMeaning() const override;
+
+  xiangqi::Screen screen = xiangqi::Screen::Menu;
+  int howToPage = 0;
+  xiangqi::Opponent opponent = xiangqi::Opponent::Computer;
+  uint8_t seat = xiangqi::kRed;
+  xiangqi::Game game{};
+
+  xiangqi::MoveList legal;
+  xiangqi::Outcome cachedOutcome = xiangqi::Outcome::Running;
+  bool cachedCheck = false;
+
+  int picked = xiangqi::kNothingPicked;
+  xiangqi::Targets targets{};
+
+  bool engineThinking = false;
+  xiangqi::SearchBuffers searchBuffers;
+
+  int wins = 0;
+  int losses = 0;
+  int draws = 0;
+  bool resultRecorded = false;
+  bool canContinue = false;
+
+  linkplay::Play<xiangqi::Game> play;
+
+  toybox::Interactions interactions;
+  bool interactionsReady = false;
+};
diff --git a/src/apps_local/xiangqi/XiangqiCore.cpp b/src/apps_local/xiangqi/XiangqiCore.cpp
new file mode 100644
index 00000000..cad7effc
--- /dev/null
+++ b/src/apps_local/xiangqi/XiangqiCore.cpp
@@ -0,0 +1,416 @@
+#include "XiangqiCore.h"
+
+namespace xiangqi {
+
+namespace {
+
+constexpr int8_t kOrthFile[4] = {0, 0, -1, 1};
+constexpr int8_t kOrthRank[4] = {-1, 1, 0, 0};
+constexpr int8_t kDiagFile[4] = {-1, 1, -1, 1};
+constexpr int8_t kDiagRank[4] = {-1, -1, 1, 1};
+// The eight horse jumps. The leg is the orthogonal neighbour in the direction
+// of the long arm.
+constexpr int8_t kHorseFile[8] = {-1, 1, -2, 2, -2, 2, -1, 1};
+constexpr int8_t kHorseRank[8] = {-2, -2, -1, -1, 1, 1, 2, 2};
+
+inline bool ownedBy(const uint8_t cell, const uint8_t seat) { return cell != 0 && ownerOf(cell) == seat; }
+
+inline void legOf(const int df, const int dr, int& lf, int& lr) {
+  if (dr == 2 || dr == -2) {
+    lf = 0;
+    lr = dr / 2;
+  } else {
+    lf = df / 2;
+    lr = 0;
+  }
+}
+
+void addIfNotOwn(const Board& board, MoveList& list, const int from, const int f, const int r, const uint8_t seat) {
+  const int to = indexOf(f, r);
+  if (ownedBy(board.cell[to], seat)) return;
+  list.add(Move{static_cast<uint8_t>(from), static_cast<uint8_t>(to)});
+}
+
+uint8_t fromFenLetter(const char c, uint8_t& owner) {
+  owner = (c >= 'a' && c <= 'z') ? kBlack : kRed;
+  switch (c | 0x20) {
+    case 'k':
+      return General;
+    case 'a':
+      return Advisor;
+    case 'b':
+    case 'e':
+      return Elephant;
+    case 'n':
+    case 'h':
+      return Horse;
+    case 'r':
+      return Chariot;
+    case 'c':
+      return Cannon;
+    case 'p':
+      return Soldier;
+    default:
+      return None;
+  }
+}
+
+}  // namespace
+
+void start(Board& board) { parseFen("rnbakabnr/9/1c5c1/p1p1p1p1p/9/9/P1P1P1P1P/1C5C1/9/RNBAKABNR w", board); }
+
+bool parseFen(const char* fen, Board& out) {
+  if (fen == nullptr) return false;
+  Board board{};
+  const char* c = fen;
+  int file = 0;
+  int rank = 0;
+  for (; *c != '\0' && *c != ' '; ++c) {
+    if (*c == '/') {
+      if (file != kFiles) return false;
+      ++rank;
+      file = 0;
+      continue;
+    }
+    if (*c >= '1' && *c <= '9') {
+      file += *c - '0';
+      if (file > kFiles) return false;
+      continue;
+    }
+    uint8_t owner = kRed;
+    const uint8_t type = fromFenLetter(*c, owner);
+    if (type == None || file >= kFiles || rank >= kRanks) return false;
+    board.cell[indexOf(file, rank)] = makeCell(type, owner);
+    ++file;
+  }
+  if (rank != kRanks - 1 || file != kFiles || *c != ' ') return false;
+  ++c;
+  if (*c == 'w' || *c == 'r') {
+    board.turn = kRed;
+  } else if (*c == 'b') {
+    board.turn = kBlack;
+  } else {
+    return false;
+  }
+  out = board;
+  return true;
+}
+
+int generalSquare(const Board& board, const uint8_t seat) {
+  const uint8_t general = makeCell(General, seat);
+  // Only the palaces can hold one, so only the palaces are searched.
+  const int r0 = seat == kRed ? 7 : 0;
+  for (int r = r0; r < r0 + 3; ++r) {
+    for (int f = 3; f <= 5; ++f) {
+      if (board.cell[indexOf(f, r)] == general) return indexOf(f, r);
+    }
+  }
+  return -1;
+}
+
+bool isAttacked(const Board& board, const int point, const uint8_t by) {
+  const int pf = fileOf(point);
+  const int pr = rankOf(point);
+
+  // Lines: a chariot as the first piece, a cannon as the second. A general as
+  // the first piece on the FILE is the facing rule; one point away on the rank
+  // is an ordinary general step (only possible inside its palace).
+  for (int d = 0; d < 4; ++d) {
+    int f = pf + kOrthFile[d];
+    int r = pr + kOrthRank[d];
+    int seen = 0;
+    int distance = 1;
+    while (inside(f, r)) {
+      const uint8_t cell = board.cell[indexOf(f, r)];
+      if (cell != 0) {
+        ++seen;
+        if (seen == 1) {
+          if (ownedBy(cell, by)) {
+            const uint8_t type = typeOf(cell);
+            if (type == Chariot) return true;
+            if (type == General && (kOrthFile[d] == 0 || (distance == 1 && inPalace(pf, pr, by)))) return true;
+          }
+        } else {
+          if (ownedBy(cell, by) && typeOf(cell) == Cannon) return true;
+          break;
+        }
+      }
+      f += kOrthFile[d];
+      r += kOrthRank[d];
+      ++distance;
+    }
+  }
+
+  // Horses, each checked against its own leg.
+  for (int i = 0; i < 8; ++i) {
+    const int hf = pf - kHorseFile[i];
+    const int hr = pr - kHorseRank[i];
+    if (!inside(hf, hr)) continue;
+    const uint8_t cell = board.cell[indexOf(hf, hr)];
+    if (!ownedBy(cell, by) || typeOf(cell) != Horse) continue;
+    int lf = 0;
+    int lr = 0;
+    legOf(kHorseFile[i], kHorseRank[i], lf, lr);
+    if (board.cell[indexOf(hf + lf, hr + lr)] == 0) return true;
+  }
+
+  // Soldiers: from behind (in their direction of travel), or from the side
+  // once they have crossed the river.
+  {
+    const int sr = pr - forward(by);
+    if (inside(pf, sr) && board.cell[indexOf(pf, sr)] == makeCell(Soldier, by)) return true;
+    if (!ownSide(pr, by)) {
+      for (int df = -1; df <= 1; df += 2) {
+        if (inside(pf + df, pr) && board.cell[indexOf(pf + df, pr)] == makeCell(Soldier, by)) return true;
+      }
+    }
+  }
+
+  // Advisors and elephants reach only their own side, so they can only ever
+  // attack a point there.
+  if (inPalace(pf, pr, by)) {
+    for (int d = 0; d < 4; ++d) {
+      const int f = pf + kDiagFile[d];
+      const int r = pr + kDiagRank[d];
+      if (inside(f, r) && board.cell[indexOf(f, r)] == makeCell(Advisor, by)) return true;
+    }
+  }
+  if (ownSide(pr, by)) {
+    for (int d = 0; d < 4; ++d) {
+      const int f = pf + kDiagFile[d] * 2;
+      const int r = pr + kDiagRank[d] * 2;
+      if (!inside(f, r) || board.cell[indexOf(f, r)] != makeCell(Elephant, by)) continue;
+      if (board.cell[indexOf(pf + kDiagFile[d], pr + kDiagRank[d])] == 0) return true;
+    }
+  }
+  return false;
+}
+
+bool inCheck(const Board& board, const uint8_t seat) {
+  const int general = generalSquare(board, seat);
+  return general >= 0 && isAttacked(board, general, other(seat));
+}
+
+void generatePseudo(const Board& board, MoveList& list) {
+  list.clear();
+  const uint8_t seat = board.turn;
+  for (int from = 0; from < kPoints; ++from) {
+    const uint8_t cell = board.cell[from];
+    if (!ownedBy(cell, seat)) continue;
+    const int ff = fileOf(from);
+    const int fr = rankOf(from);
+    switch (typeOf(cell)) {
+      case General:
+        for (int d = 0; d < 4; ++d) {
+          const int f = ff + kOrthFile[d];
+          const int r = fr + kOrthRank[d];
+          if (inPalace(f, r, seat)) addIfNotOwn(board, list, from, f, r, seat);
+        }
+        break;
+      case Advisor:
+        for (int d = 0; d < 4; ++d) {
+          const int f = ff + kDiagFile[d];
+          const int r = fr + kDiagRank[d];
+          if (inPalace(f, r, seat)) addIfNotOwn(board, list, from, f, r, seat);
+        }
+        break;
+      case Elephant:
+        for (int d = 0; d < 4; ++d) {
+          const int f = ff + kDiagFile[d] * 2;
+          const int r = fr + kDiagRank[d] * 2;
+          if (!inside(f, r) || !ownSide(r, seat)) continue;
+          if (board.cell[indexOf(ff + kDiagFile[d], fr + kDiagRank[d])] != 0) continue;
+          addIfNotOwn(board, list, from, f, r, seat);
+        }
+        break;
+      case Horse:
+        for (int i = 0; i < 8; ++i) {
+          const int f = ff + kHorseFile[i];
+          const int r = fr + kHorseRank[i];
+          if (!inside(f, r)) continue;
+          int lf = 0;
+          int lr = 0;
+          legOf(kHorseFile[i], kHorseRank[i], lf, lr);
+          if (board.cell[indexOf(ff + lf, fr + lr)] != 0) continue;
+          addIfNotOwn(board, list, from, f, r, seat);
+        }
+        break;
+      case Chariot:
+        for (int d = 0; d < 4; ++d) {
+          int f = ff + kOrthFile[d];
+          int r = fr + kOrthRank[d];
+          while (inside(f, r)) {
+            const uint8_t target = board.cell[indexOf(f, r)];
+            if (!ownedBy(target, seat)) list.add(Move{static_cast<uint8_t>(from), static_cast<uint8_t>(indexOf(f, r))});
+            if (target != 0) break;
+            f += kOrthFile[d];
+            r += kOrthRank[d];
+          }
+        }
+        break;
+      case Cannon:
+        for (int d = 0; d < 4; ++d) {
+          int f = ff + kOrthFile[d];
+          int r = fr + kOrthRank[d];
+          bool screened = false;
+          while (inside(f, r)) {
+            const uint8_t target = board.cell[indexOf(f, r)];
+            if (!screened) {
+              if (target == 0) {
+                list.add(Move{static_cast<uint8_t>(from), static_cast<uint8_t>(indexOf(f, r))});
+              } else {
+                screened = true;
+              }
+            } else if (target != 0) {
+              if (!ownedBy(target, seat))
+                list.add(Move{static_cast<uint8_t>(from), static_cast<uint8_t>(indexOf(f, r))});
+              break;
+            }
+            f += kOrthFile[d];
+            r += kOrthRank[d];
+          }
+        }
+        break;
+      case Soldier: {
+        const int r = fr + forward(seat);
+        if (inside(ff, r)) addIfNotOwn(board, list, from, ff, r, seat);
+        if (!ownSide(fr, seat)) {
+          for (int df = -1; df <= 1; df += 2) {
+            if (inside(ff + df, fr)) addIfNotOwn(board, list, from, ff + df, fr, seat);
+          }
+        }
+        break;
+      }
+      default:
+        break;
+    }
+  }
+}
+
+void makeMove(Board& board, const Move& move) {
+  board.cell[move.to] = board.cell[move.from];
+  board.cell[move.from] = 0;
+  board.turn = other(board.turn);
+}
+
+bool isLegal(const Board& board, const Move& move) {
+  Board next = board;
+  makeMove(next, move);
+  const int general = generalSquare(next, board.turn);
+  return general < 0 || !isAttacked(next, general, next.turn);
+}
+
+void generateLegal(const Board& board, MoveList& list) {
+  generatePseudo(board, list);
+  int kept = 0;
+  for (int i = 0; i < list.count; ++i) {
+    if (isLegal(board, list.moves[i])) list.moves[kept++] = list.moves[i];
+  }
+  list.count = kept;
+}
+
+bool hasLegalMove(const Board& board) {
+  static MoveList scratch;
+  generatePseudo(board, scratch);
+  for (int i = 0; i < scratch.count; ++i) {
+    if (isLegal(board, scratch.moves[i])) return true;
+  }
+  return false;
+}
+
+uint64_t perft(const Board& board, const int depth) {
+  if (depth == 0) return 1;
+  MoveList list;
+  generateLegal(board, list);
+  if (depth == 1) return static_cast<uint64_t>(list.count);
+  uint64_t nodes = 0;
+  for (int i = 0; i < list.count; ++i) {
+    Board next = board;
+    makeMove(next, list.moves[i]);
+    nodes += perft(next, depth - 1);
+  }
+  return nodes;
+}
+
+uint32_t positionKey(const Board& board) {
+  uint32_t hash = 2166136261u;
+  for (int i = 0; i < kPoints; ++i) {
+    hash ^= board.cell[i];
+    hash *= 16777619u;
+  }
+  hash ^= board.turn;
+  hash *= 16777619u;
+  return hash;
+}
+
+void moveToIccs(const Move& move, char* out) {
+  out[0] = static_cast<char>('a' + fileOf(move.from));
+  out[1] = static_cast<char>('0' + (kRanks - 1 - rankOf(move.from)));
+  out[2] = static_cast<char>('a' + fileOf(move.to));
+  out[3] = static_cast<char>('0' + (kRanks - 1 - rankOf(move.to)));
+  out[4] = '\0';
+}
+
+// ---------------------------------------------------------------------------
+
+namespace {
+
+void remember(Game& game) {
+  game.keys[game.keyHead] = positionKey(game.board);
+  game.keyHead = static_cast<uint8_t>((game.keyHead + 1) % kKeyRing);
+  if (game.keyCount < kKeyRing) ++game.keyCount;
+}
+
+}  // namespace
+
+void startGame(Game& game) {
+  game = Game{};
+  start(game.board);
+  game.lastFrom = kNoPoint;
+  game.lastTo = kNoPoint;
+  remember(game);
+}
+
+bool play(Game& game, const Move& move) {
+  static MoveList pseudo;
+  generatePseudo(game.board, pseudo);
+  for (int i = 0; i < pseudo.count; ++i) {
+    if (!sameMove(pseudo.moves[i], move)) continue;
+    if (!isLegal(game.board, move)) return false;
+    const bool capture = game.board.cell[move.to] != 0;
+    makeMove(game.board, move);
+    game.lastFrom = move.from;
+    game.lastTo = move.to;
+    if (game.plies < 0xFFFF) ++game.plies;
+    if (capture) {
+      game.idlePlies = 0;
+      // A capture is irreversible: nothing before it can come back, so the
+      // ring starts over and an old position cannot be miscounted.
+      game.keyCount = 0;
+      game.keyHead = 0;
+    } else if (game.idlePlies < 255) {
+      ++game.idlePlies;
+    }
+    remember(game);
+    return true;
+  }
+  return false;
+}
+
+int repetitions(const Game& game) {
+  const uint32_t now = positionKey(game.board);
+  int count = 0;
+  for (int i = 0; i < game.keyCount; ++i) {
+    if (game.keys[i] == now) ++count;
+  }
+  return count;
+}
+
+Outcome outcome(const Game& game) {
+  if (!hasLegalMove(game.board)) return game.board.turn == kRed ? Outcome::BlackWins : Outcome::RedWins;
+  if (repetitions(game) >= kRepetitionDraw) return Outcome::Draw;
+  if (game.idlePlies >= kIdleLimit || game.plies >= kMaxPlies) return Outcome::Draw;
+  return Outcome::Running;
+}
+
+}  // namespace xiangqi
diff --git a/src/apps_local/xiangqi/XiangqiCore.h b/src/apps_local/xiangqi/XiangqiCore.h
new file mode 100644
index 00000000..aebbbb88
--- /dev/null
+++ b/src/apps_local/xiangqi/XiangqiCore.h
@@ -0,0 +1,159 @@
+#pragma once
+
+// Xiangqi (Chinese chess), the rules. Freestanding C++17: no Arduino, no
+// renderer, no heap, verified on the host against published perft counts
+// (host-tests/xiangqi/run.sh).
+//
+// Pieces stand on the 90 POINTS of a 9 x 10 grid, not in squares. Index =
+// rank * 9 + file. Rank 0 is the top edge, Black's back rank; Red moves first
+// and plays up the board from rank 9. The river runs between ranks 4 and 5.
+// FEN lists points in exactly this order.
+//
+// The rules that make it xiangqi, all in move generation or legality:
+//   - generals and advisors never leave their 3 x 3 palace;
+//   - elephants never cross the river and are stopped by a piece on the "eye";
+//   - horses are stopped by a piece on the "leg" next to them;
+//   - cannons move like chariots but capture only by jumping exactly one piece;
+//   - soldiers gain sideways steps only once across the river;
+//   - the two generals may never face each other on an open file.
+// Having no legal move loses, whether in check or not.
+
+#include <cstdint>
+
+namespace xiangqi {
+
+constexpr int kFiles = 9;
+constexpr int kRanks = 10;
+constexpr int kPoints = kFiles * kRanks;
+
+constexpr uint8_t kRed = 0;
+constexpr uint8_t kBlack = 1;
+
+enum Type : uint8_t {
+  None = 0,
+  General = 1,
+  Advisor = 2,
+  Elephant = 3,
+  Horse = 4,
+  Chariot = 5,
+  Cannon = 6,
+  Soldier = 7,
+};
+
+constexpr uint8_t kBlackFlag = 0x08;
+constexpr uint8_t kTypeMask = 0x07;
+
+constexpr uint8_t typeOf(const uint8_t cell) { return cell & kTypeMask; }
+constexpr uint8_t ownerOf(const uint8_t cell) { return (cell & kBlackFlag) != 0 ? kBlack : kRed; }
+constexpr uint8_t makeCell(const uint8_t type, const uint8_t owner) {
+  return static_cast<uint8_t>(type | (owner == kBlack ? kBlackFlag : 0));
+}
+constexpr uint8_t other(const uint8_t seat) { return seat == kRed ? kBlack : kRed; }
+
+struct Board {
+  uint8_t cell[kPoints];
+  uint8_t turn;
+};
+
+struct Move {
+  uint8_t from;
+  uint8_t to;
+};
+
+inline bool sameMove(const Move& a, const Move& b) { return a.from == b.from && a.to == b.to; }
+
+// Real positions offer well under a hundred; 128 is headroom.
+constexpr int kMaxMoves = 128;
+
+struct MoveList {
+  Move moves[kMaxMoves];
+  int count = 0;
+  void clear() { count = 0; }
+  void add(const Move& move) {
+    if (count < kMaxMoves) moves[count++] = move;
+  }
+};
+
+inline int fileOf(const int index) { return index % kFiles; }
+inline int rankOf(const int index) { return index / kFiles; }
+inline int indexOf(const int file, const int rank) { return rank * kFiles + file; }
+inline bool inside(const int file, const int rank) { return file >= 0 && file < kFiles && rank >= 0 && rank < kRanks; }
+
+// Bounded on BOTH sides. The first version said only "rank >= 7" for Red, and
+// perft caught Red's advisors and general stepping onto a rank 10 that does not
+// exist: 47 moves from the opening instead of 44.
+inline bool inPalace(const int file, const int rank, const uint8_t seat) {
+  if (file < 3 || file > 5) return false;
+  return seat == kRed ? (rank >= 7 && rank <= 9) : (rank >= 0 && rank <= 2);
+}
+
+// Whether `rank` is on `seat`'s own side of the river.
+inline bool ownSide(const int rank, const uint8_t seat) { return seat == kRed ? rank >= 5 : rank <= 4; }
+
+// Rank step toward the opponent.
+inline int forward(const uint8_t seat) { return seat == kRed ? -1 : 1; }
+
+void start(Board& board);
+
+// Parses a xiangqi FEN ("rnbakabnr/9/1c5c1/... w"). Accepts both letter sets in
+// common use (n or h for the horse, b or e for the elephant). Returns false and
+// leaves `board` alone on anything malformed.
+bool parseFen(const char* fen, Board& board);
+
+int generalSquare(const Board& board, uint8_t seat);
+
+// True when any piece of `by` attacks `point`, counting the facing-generals
+// rule as an attack by the general along the file.
+bool isAttacked(const Board& board, int point, uint8_t by);
+
+bool inCheck(const Board& board, uint8_t seat);
+
+void generatePseudo(const Board& board, MoveList& list);
+void makeMove(Board& board, const Move& move);
+bool isLegal(const Board& board, const Move& move);
+void generateLegal(const Board& board, MoveList& list);
+// Main-thread scratch; call from the loop, never from a render.
+bool hasLegalMove(const Board& board);
+
+uint64_t perft(const Board& board, int depth);
+uint32_t positionKey(const Board& board);
+
+// ICCS coordinates: "h2e2". Files a..i left to right from Red's side, ranks
+// 0..9 from Red's back rank. `out` must hold 5 bytes.
+void moveToIccs(const Move& move, char* out);
+
+// ---------------------------------------------------------------------------
+// The game, and the wire format for a two-device match: under 192 bytes.
+
+// Threefold repetition is called a draw here. The full Asian rules (perpetual
+// check and chase lose) need move-by-move intent tracking; a draw is the
+// simplification every casual app makes.
+constexpr int kKeyRing = 16;
+constexpr int kRepetitionDraw = 3;
+// Sixty moves each with no capture is a draw.
+constexpr uint8_t kIdleLimit = 120;
+constexpr uint16_t kMaxPlies = 400;
+
+constexpr uint8_t kNoPoint = 0xFE;
+
+struct Game {
+  Board board;
+  uint8_t lastFrom;
+  uint8_t lastTo;
+  uint8_t idlePlies;
+  uint8_t keyCount;
+  uint8_t keyHead;
+  uint8_t pad[2];
+  uint16_t plies;
+  uint32_t keys[kKeyRing];
+};
+
+enum class Outcome : uint8_t { Running, RedWins, BlackWins, Draw };
+
+void startGame(Game& game);
+bool play(Game& game, const Move& move);
+int repetitions(const Game& game);
+Outcome outcome(const Game& game);
+inline bool over(const Game& game) { return outcome(game) != Outcome::Running; }
+
+}  // namespace xiangqi
diff --git a/src/apps_local/xiangqi/XiangqiEngine.cpp b/src/apps_local/xiangqi/XiangqiEngine.cpp
new file mode 100644
index 00000000..9b09c205
--- /dev/null
+++ b/src/apps_local/xiangqi/XiangqiEngine.cpp
@@ -0,0 +1,179 @@
+#include "XiangqiEngine.h"
+
+namespace xiangqi {
+
+namespace {
+
+// Conventional values: a chariot is worth about two horses or two cannons, and
+// a soldier doubles once it has crossed the river and can move sideways.
+constexpr int kValue[8] = {0, 0, 200, 200, 400, 900, 450, 100};
+
+struct Context {
+  SearchBuffers& buffers;
+  uint32_t nodes = 0;
+  uint32_t budget = 0;
+  bool stopped = false;
+
+  bool outOfBudget() {
+    if (budget != 0 && nodes >= budget) stopped = true;
+    return stopped;
+  }
+};
+
+int orderScore(const Board& board, const Move& move, const Move* preferred) {
+  if (preferred != nullptr && sameMove(move, *preferred)) return 1000000;
+  const uint8_t victim = board.cell[move.to];
+  if (victim == 0) return 0;
+  // A general is never actually taken, but a move that "captures" one would
+  // mean the opponent left it en prise; order it first anyway.
+  const int victimValue = typeOf(victim) == General ? 5000 : kValue[typeOf(victim)];
+  return 10000 + victimValue * 8 - kValue[typeOf(board.cell[move.from])] / 16;
+}
+
+void sortMoves(const Board& board, MoveList& list, int* scores, const Move* preferred) {
+  for (int i = 0; i < list.count; ++i) scores[i] = orderScore(board, list.moves[i], preferred);
+  for (int i = 1; i < list.count; ++i) {
+    const Move move = list.moves[i];
+    const int score = scores[i];
+    int j = i - 1;
+    while (j >= 0 && scores[j] < score) {
+      list.moves[j + 1] = list.moves[j];
+      scores[j + 1] = scores[j];
+      --j;
+    }
+    list.moves[j + 1] = move;
+    scores[j + 1] = score;
+  }
+}
+
+int quiesce(Context& ctx, const Board& board, int alpha, const int beta, const int qply, const int slot) {
+  ++ctx.nodes;
+  const int standPat = evaluate(board);
+  if (qply >= kMaxQuiescence || ctx.outOfBudget()) return standPat;
+  if (standPat >= beta) return standPat;
+  if (standPat > alpha) alpha = standPat;
+
+  MoveList& list = ctx.buffers.plies[slot];
+  generatePseudo(board, list);
+  int kept = 0;
+  for (int i = 0; i < list.count; ++i) {
+    if (board.cell[list.moves[i].to] != 0) list.moves[kept++] = list.moves[i];
+  }
+  list.count = kept;
+  sortMoves(board, list, ctx.buffers.scores, nullptr);
+
+  for (int i = 0; i < list.count; ++i) {
+    const Move move = list.moves[i];
+    if (!isLegal(board, move)) continue;
+    Board next = board;
+    makeMove(next, move);
+    const int score = -quiesce(ctx, next, -beta, -alpha, qply + 1, slot + 1);
+    if (ctx.stopped) return alpha;
+    if (score >= beta) return score;
+    if (score > alpha) alpha = score;
+  }
+  return alpha;
+}
+
+int negamax(Context& ctx, const Board& board, const int depth, int alpha, const int beta, const int ply) {
+  if (depth == 0) return quiesce(ctx, board, alpha, beta, 0, ply);
+  ++ctx.nodes;
+  if (ctx.outOfBudget()) return 0;
+
+  MoveList& list = ctx.buffers.plies[ply];
+  generatePseudo(board, list);
+  sortMoves(board, list, ctx.buffers.scores, nullptr);
+
+  bool any = false;
+  int best = -kMateScore;
+  for (int i = 0; i < list.count; ++i) {
+    const Move move = list.moves[i];
+    if (!isLegal(board, move)) continue;
+    any = true;
+    Board next = board;
+    makeMove(next, move);
+    const int score = -negamax(ctx, next, depth - 1, -beta, -alpha, ply + 1);
+    if (ctx.stopped) return 0;
+    if (score > best) best = score;
+    if (score > alpha) alpha = score;
+    if (alpha >= beta) break;
+  }
+  // No legal move loses, stalemate included.
+  if (!any) return -kMateScore + ply;
+  return best;
+}
+
+}  // namespace
+
+int pieceValue(const uint8_t type) { return kValue[type & kTypeMask]; }
+
+int evaluate(const Board& board) {
+  int score[2] = {0, 0};
+  for (int i = 0; i < kPoints; ++i) {
+    const uint8_t cell = board.cell[i];
+    if (cell == 0) continue;
+    const uint8_t owner = ownerOf(cell);
+    const uint8_t type = typeOf(cell);
+    const int file = fileOf(i);
+    const int rank = rankOf(i);
+    score[owner] += kValue[type];
+    if (type == Soldier && !ownSide(rank, owner)) {
+      // Across the river: worth double, and more the nearer the palace and the
+      // centre files it gets.
+      const int depth = owner == kRed ? 4 - rank : rank - 5;
+      score[owner] += 100 + 10 * depth - 6 * (file > 4 ? file - 4 : 4 - file);
+    }
+    if (type == Horse || type == Cannon) {
+      // Mildly central pieces, mildly advanced horses.
+      score[owner] -= 4 * (file > 4 ? file - 4 : 4 - file);
+      if (type == Horse && !ownSide(rank, owner)) score[owner] += 20;
+    }
+  }
+  const int mine = board.turn;
+  return score[mine] - score[other(static_cast<uint8_t>(mine))];
+}
+
+SearchResult search(const Board& board, const int maxDepth, SearchBuffers& buffers, const uint32_t nodeBudget) {
+  SearchResult result;
+  Context ctx{buffers};
+  ctx.budget = nodeBudget;
+
+  MoveList& root = buffers.plies[kMaxSearchDepth + kMaxQuiescence];
+  generateLegal(board, root);
+  if (root.count == 0) return result;
+  result.hasMove = true;
+  result.best = root.moves[0];
+
+  const int depthCap = maxDepth < 1 ? 1 : (maxDepth > kMaxSearchDepth ? kMaxSearchDepth : maxDepth);
+  for (int depth = 1; depth <= depthCap; ++depth) {
+    const Move preferred = result.best;
+    sortMoves(board, root, buffers.scores, &preferred);
+    int alpha = -kMateScore - 1;
+    const int beta = kMateScore + 1;
+    Move bestHere = root.moves[0];
+    int bestScore = -kMateScore - 1;
+    for (int i = 0; i < root.count; ++i) {
+      Board next = board;
+      makeMove(next, root.moves[i]);
+      const int score = -negamax(ctx, next, depth - 1, -beta, -alpha, 1);
+      if (ctx.stopped) break;
+      if (score > bestScore) {
+        bestScore = score;
+        bestHere = root.moves[i];
+      }
+      if (score > alpha) alpha = score;
+    }
+    if (ctx.stopped) {
+      result.budgetExhausted = true;
+      break;
+    }
+    result.best = bestHere;
+    result.score = bestScore;
+    result.depthCompleted = depth;
+    if (bestScore >= kMateThreshold) break;
+  }
+  result.nodes = ctx.nodes;
+  return result;
+}
+
+}  // namespace xiangqi
diff --git a/src/apps_local/xiangqi/XiangqiEngine.h b/src/apps_local/xiangqi/XiangqiEngine.h
new file mode 100644
index 00000000..bfa67174
--- /dev/null
+++ b/src/apps_local/xiangqi/XiangqiEngine.h
@@ -0,0 +1,42 @@
+#pragma once
+
+// The built-in Xiangqi opponent: iterative-deepening alpha-beta with a capture
+// quiescence search, bounded by a deterministic node budget. Freestanding and
+// copy-make, the same shape as ShogiEngine; see that header for why.
+
+#include <cstdint>
+
+#include "XiangqiCore.h"
+
+namespace xiangqi {
+
+constexpr int kMateScore = 30000;
+constexpr int kMateThreshold = kMateScore - 1000;
+
+constexpr int kMaxSearchDepth = 5;
+constexpr int kMaxQuiescence = 6;
+
+struct SearchBuffers {
+  MoveList plies[kMaxSearchDepth + kMaxQuiescence + 1];
+  int scores[kMaxMoves];
+};
+
+struct SearchResult {
+  Move best{};
+  int score = 0;
+  uint32_t nodes = 0;
+  int depthCompleted = 0;
+  bool budgetExhausted = false;
+  bool hasMove = false;
+};
+
+int pieceValue(uint8_t type);
+
+// Material plus small positional terms, from the side-to-move's view.
+int evaluate(const Board& board);
+
+// Best move of the deepest completed iteration up to `maxDepth` within
+// `nodeBudget` nodes (0 = unbounded). hasMove is false only with no legal move.
+SearchResult search(const Board& board, int maxDepth, SearchBuffers& buffers, uint32_t nodeBudget);
+
+}  // namespace xiangqi
diff --git a/src/apps_local/xiangqi/XiangqiFlow.h b/src/apps_local/xiangqi/XiangqiFlow.h
new file mode 100644
index 00000000..6ee45381
--- /dev/null
+++ b/src/apps_local/xiangqi/XiangqiFlow.h
@@ -0,0 +1,89 @@
+#pragma once
+
+// Xiangqi's navigation and the state between two taps. Freestanding.
+//
+// Same discipline as Shogi's and Checkers': every mark the board draws is read
+// out of the rules' own legal move list, so a marked point is always one the
+// rules will accept.
+
+#include <cstdint>
+
+#include "XiangqiCore.h"
+
+namespace xiangqi {
+
+enum class Screen : uint8_t { Menu, HowTo, Board, Result };
+
+constexpr Screen back(const Screen screen) {
+  switch (screen) {
+    case Screen::Menu:
+      return Screen::Menu;
+    case Screen::HowTo:
+    case Screen::Board:
+    case Screen::Result:
+      return Screen::Menu;
+  }
+  return Screen::Menu;
+}
+
+constexpr bool leavesApp(const Screen screen) { return screen == Screen::Menu; }
+
+enum class Opponent : uint8_t { Computer = 0, Friend = 1 };
+
+constexpr int kNothingPicked = -1;
+
+struct Targets {
+  uint8_t to[kPoints];
+  bool capture[kPoints];
+  int count = 0;
+};
+
+inline void targetsFor(const Board& board, const MoveList& legal, const int from, Targets& out) {
+  out.count = 0;
+  if (from < 0) return;
+  for (int i = 0; i < legal.count; ++i) {
+    if (legal.moves[i].from != from) continue;
+    out.to[out.count] = legal.moves[i].to;
+    out.capture[out.count] = board.cell[legal.moves[i].to] != 0;
+    ++out.count;
+  }
+}
+
+inline bool canPick(const MoveList& legal, const int point) {
+  for (int i = 0; i < legal.count; ++i) {
+    if (legal.moves[i].from == point) return true;
+  }
+  return false;
+}
+
+inline bool moveBetween(const MoveList& legal, const int from, const int to, Move& out) {
+  for (int i = 0; i < legal.count; ++i) {
+    if (legal.moves[i].from != from || legal.moves[i].to != to) continue;
+    out = legal.moves[i];
+    return true;
+  }
+  return false;
+}
+
+enum class Ending : uint8_t { None, Checkmate, Stalemate, Repetition, NoCaptures, MoveLimit };
+
+inline Ending endingOf(const Game& game, const Outcome result) {
+  if (result == Outcome::Running) return Ending::None;
+  if (result == Outcome::Draw) {
+    if (repetitions(game) >= kRepetitionDraw) return Ending::Repetition;
+    return game.idlePlies >= kIdleLimit ? Ending::NoCaptures : Ending::MoveLimit;
+  }
+  return inCheck(game.board, game.board.turn) ? Ending::Checkmate : Ending::Stalemate;
+}
+
+// Material each side still has on the board, by type, for the strip under the
+// board: which pieces are gone is what a player scans for.
+inline int countOf(const Board& board, const uint8_t seat, const uint8_t type) {
+  int n = 0;
+  for (int i = 0; i < kPoints; ++i) {
+    if (board.cell[i] == makeCell(type, seat)) ++n;
+  }
+  return n;
+}
+
+}  // namespace xiangqi
diff --git a/src/apps_local/xiangqi/XiangqiSave.h b/src/apps_local/xiangqi/XiangqiSave.h
new file mode 100644
index 00000000..8189ff86
--- /dev/null
+++ b/src/apps_local/xiangqi/XiangqiSave.h
@@ -0,0 +1,123 @@
+#pragma once
+
+// Xiangqi's save file: a freestanding pack/unpack pair, host-tested. One line:
+//
+//   XIANGQI1 <wins> <losses> <draws> <inProgress> <opponent> <seat> <hex of Game>
+//
+// Same shape and reasoning as ShogiSave.h: the Game struct is the wire format,
+// so it is also the only serialisation of a position, and unpack refuses any
+// board the rules could not have produced.
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include "XiangqiCore.h"
+#include "XiangqiFlow.h"
+
+namespace xiangqisave {
+
+constexpr char kMagic[] = "XIANGQI1";
+constexpr int kMaxLine = 64 + static_cast<int>(sizeof(xiangqi::Game)) * 2;
+
+struct Save {
+  int wins = 0;
+  int losses = 0;
+  int draws = 0;
+  bool inProgress = false;
+  xiangqi::Opponent opponent = xiangqi::Opponent::Computer;
+  uint8_t seat = xiangqi::kRed;
+  xiangqi::Game game{};
+};
+
+// One general each inside its own palace, nothing beyond the set's counts,
+// elephants and advisors on the squares they can reach, soldiers never behind
+// their starting rank.
+inline bool plausible(const xiangqi::Game& game) {
+  // Qualified rather than `using namespace xiangqi`: the device build has a global
+  // `None` of its own, and the using-directive made every bare None ambiguous
+  // there while the host build, which never sees that header, compiled clean.
+  namespace g = xiangqi;
+  if (game.board.turn > g::kBlack) return false;
+  if (game.keyCount > g::kKeyRing || game.keyHead >= g::kKeyRing) return false;
+  static constexpr int kSet[8] = {0, 1, 2, 2, 2, 2, 2, 5};
+  int count[2][8] = {};
+  for (int i = 0; i < g::kPoints; ++i) {
+    const uint8_t cell = game.board.cell[i];
+    if (cell == 0) continue;
+    if ((cell & ~(g::kTypeMask | g::kBlackFlag)) != 0) return false;
+    const uint8_t type = g::typeOf(cell);
+    const uint8_t owner = g::ownerOf(cell);
+    if (type == g::None) return false;
+    const int f = g::fileOf(i);
+    const int r = g::rankOf(i);
+    if ((type == g::General || type == g::Advisor) && !g::inPalace(f, r, owner)) return false;
+    if (type == g::Elephant && !g::ownSide(r, owner)) return false;
+    if (type == g::Soldier && (owner == g::kRed ? r > 6 : r < 3)) return false;
+    ++count[owner][type];
+  }
+  for (int seat = 0; seat < 2; ++seat) {
+    if (count[seat][g::General] != 1) return false;
+    for (int t = 1; t < 8; ++t) {
+      if (count[seat][t] > kSet[t]) return false;
+    }
+  }
+  return true;
+}
+
+inline int pack(const Save& save, char* out, const int capacity) {
+  int used =
+      std::snprintf(out, static_cast<size_t>(capacity), "%s %d %d %d %d %d %d ", kMagic, save.wins, save.losses,
+                    save.draws, save.inProgress ? 1 : 0, static_cast<int>(save.opponent), static_cast<int>(save.seat));
+  if (used <= 0 || used >= capacity) return 0;
+  const auto* bytes = reinterpret_cast<const uint8_t*>(&save.game);
+  static constexpr char kHex[] = "0123456789abcdef";
+  for (size_t i = 0; i < sizeof(xiangqi::Game); ++i) {
+    if (used + 3 >= capacity) return 0;
+    out[used++] = kHex[bytes[i] >> 4];
+    out[used++] = kHex[bytes[i] & 15];
+  }
+  out[used++] = '\n';
+  out[used] = '\0';
+  return used;
+}
+
+inline int hexValue(const char c) {
+  if (c >= '0' && c <= '9') return c - '0';
+  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+  return -1;
+}
+
+inline bool unpack(const char* line, Save& out) {
+  if (line == nullptr || std::strncmp(line, kMagic, sizeof(kMagic) - 1) != 0) return false;
+  int wins = 0, losses = 0, draws = 0, inProgress = 0, opponent = 0, seat = 0, consumed = 0;
+  if (std::sscanf(line + sizeof(kMagic) - 1, " %d %d %d %d %d %d %n", &wins, &losses, &draws, &inProgress, &opponent,
+                  &seat, &consumed) != 6) {
+    return false;
+  }
+  if (wins < 0 || losses < 0 || draws < 0 || (inProgress != 0 && inProgress != 1)) return false;
+  if (opponent != 0 && opponent != 1) return false;
+  if (seat != xiangqi::kRed && seat != xiangqi::kBlack) return false;
+  const char* hex = line + sizeof(kMagic) - 1 + consumed;
+  Save parsed;
+  auto* bytes = reinterpret_cast<uint8_t*>(&parsed.game);
+  for (size_t i = 0; i < sizeof(xiangqi::Game); ++i) {
+    const int hi = hexValue(hex[i * 2]);
+    const int lo = hi < 0 ? -1 : hexValue(hex[i * 2 + 1]);
+    if (hi < 0 || lo < 0) return false;
+    bytes[i] = static_cast<uint8_t>(hi * 16 + lo);
+  }
+  const char tail = hex[sizeof(xiangqi::Game) * 2];
+  if (tail != '\0' && tail != '\n' && tail != '\r') return false;
+  if (!plausible(parsed.game)) return false;
+  parsed.wins = wins;
+  parsed.losses = losses;
+  parsed.draws = draws;
+  parsed.inProgress = inProgress == 1;
+  parsed.opponent = static_cast<xiangqi::Opponent>(opponent);
+  parsed.seat = static_cast<uint8_t>(seat);
+  out = parsed;
+  return true;
+}
+
+}  // namespace xiangqisave
diff --git a/src/apps_local/xiangqi/XiangqiScreens.cpp b/src/apps_local/xiangqi/XiangqiScreens.cpp
