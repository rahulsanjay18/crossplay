@@ -0,0 +1,99 @@
+#pragma once
+
+// Shogi on the device. The thin layer: renderer, input, storage, the shelf,
+// the engine's deferral and the link.
+//
+// Three ways to play, one board: against the built-in engine, two people
+// passing the device (TWO PLAYERS), and two devices (PLAY NEARBY, via
+// LinkActivity). The board never knows which; the activity decides whose taps
+// count and who answers.
+
+#include <memory>
+
+#include "../link/LinkActivity.h"
+#include "../ui/ToyboxScreen.h"
+#include "ShogiCore.h"
+#include "ShogiEngine.h"
+#include "ShogiFlow.h"
+
+class ShogiActivity final : public linkplay::LinkActivity {
+ public:
+  ShogiActivity(GfxRenderer& renderer, MappedInputManager& mappedInput)
+      : linkplay::LinkActivity("Shogi", renderer, mappedInput) {}
+  ~ShogiActivity() override = default;
+
+  static std::unique_ptr<Activity> create(GfxRenderer& renderer, MappedInputManager& mappedInput);
+
+  void onEnter() override;
+  void onExit() override;
+
+ protected:
+  linkplay::PlayBase& linkState() override { return play; }
+  const linkplay::PlayBase& linkState() const override { return play; }
+  const char* linkGameTitle() const override { return "SHOGI"; }
+  const char* linkHeadline() const override;
+  void onMatchStart(bool goesFirst) override;
+  bool takeOpponentState() override;
+  void onRematch() override;
+  void onLinkEnded() override;
+  // Read from the cache, never from the rules: this can be asked from a
+  // render, and the rules use main-thread scratch.
+  bool matchGameOver() const override { return cachedOutcome != shogi::Outcome::Running; }
+  void onMatchEnded() override;
+  void gameLoop() override;
+  void gameRender() override;
+
+ private:
+  void startGame(shogi::Opponent who);
+  void resumeGame();
+  void goTo(shogi::Screen next);
+  void clearPick();
+  // Recomputes everything a paint needs from the rules, on the main loop, so
+  // the render task never runs move generation.
+  void refresh();
+  void afterMove();
+  void commitMove(int to, bool promote);
+  void handleSquare(int square);
+  void handleHand(bool bottom, int slot);
+  void playEngineMove();
+  bool myMove() const;
+  bool engineToMove() const;
+  const char* statusText() const;
+  void recordResult();
+  void loadSave();
+  void writeSave();
+
+  uint32_t surfaceMeaning() const override;
+
+  shogi::Screen screen = shogi::Screen::Menu;
+  int howToPage = 0;
+  shogi::Opponent opponent = shogi::Opponent::Computer;
+  // The side drawn at the bottom. Sente against the computer and with a friend;
+  // the coin toss decides it in a link match.
+  uint8_t seat = shogi::kSente;
+  shogi::Game game{};
+
+  // Cached by refresh().
+  shogi::MoveList legal;
+  shogi::Outcome cachedOutcome = shogi::Outcome::Running;
+  bool cachedCheck = false;
+
+  shogi::Pick pick{};
+  shogi::Targets targets{};
+  bool askPromotion = false;
+  int pendingTo = -1;
+
+  bool engineThinking = false;
+  shogi::SearchBuffers searchBuffers;
+
+  int wins = 0;
+  int losses = 0;
+  int draws = 0;
+  bool resultRecorded = false;
+  bool canContinue = false;
+
+  linkplay::Play<shogi::Game> play;
+
+  toybox::Interactions interactions;
+  bool interactionsReady = false;
+};
diff --git a/src/apps_local/shogi/ShogiCore.cpp b/src/apps_local/shogi/ShogiCore.cpp
new file mode 100644
index 00000000..eab4a6ad
--- /dev/null
+++ b/src/apps_local/shogi/ShogiCore.cpp
@@ -0,0 +1,431 @@
+#include "ShogiCore.h"
+
+namespace shogi {
+
+namespace {
+
+// Ten directions as (file, rank) offsets in SENTE's orientation, where forward
+// is rank - 1. Gote uses each one rotated half a turn. Eight king directions,
+// then the two knight jumps.
+constexpr int8_t kDirFile[10] = {-1, 0, 1, -1, 1, -1, 0, 1, -1, 1};
+constexpr int8_t kDirRank[10] = {-1, -1, -1, 0, 0, 1, 1, 1, -2, -2};
+
+// Not `dirBit()`: Arduino.h defines dirBit(b) as a function-like macro, and any
+// translation unit that reaches it would silently rewrite this.
+constexpr uint16_t dirBit(const int i) { return static_cast<uint16_t>(1u << i); }
+
+// The gold's six: three forward, two sideways, one straight back. Every
+// promoted minor piece moves like this.
+constexpr uint16_t kGoldSteps = dirBit(0) | dirBit(1) | dirBit(2) | dirBit(3) | dirBit(4) | dirBit(6);
+constexpr uint16_t kDiagonals = dirBit(0) | dirBit(2) | dirBit(5) | dirBit(7);
+constexpr uint16_t kOrthogonals = dirBit(1) | dirBit(3) | dirBit(4) | dirBit(6);
+
+// One step in each direction set. Indexed by type.
+constexpr uint16_t kSteps[16] = {
+    0,                                                          // None
+    dirBit(1),                                                  // Pawn
+    0,                                                          // Lance (slides)
+    dirBit(8) | dirBit(9),                                      // Knight
+    dirBit(0) | dirBit(1) | dirBit(2) | dirBit(5) | dirBit(7),  // Silver
+    kGoldSteps,                                                 // Gold
+    0,                                                          // Bishop (slides)
+    0,                                                          // Rook (slides)
+    kDiagonals | kOrthogonals,                                  // King
+    kGoldSteps,                                                 // Tokin
+    kGoldSteps,                                                 // PLance
+    kGoldSteps,                                                 // PKnight
+    kGoldSteps,                                                 // PSilver
+    0,                                                          // 13 does not exist
+    kOrthogonals,                                               // Horse: bishop + one orthogonal step
+    kDiagonals,                                                 // Dragon: rook + one diagonal step
+};
+
+// Unlimited slides. Only directions 0..7 ever slide.
+constexpr uint16_t kSlides[16] = {
+    0, 0, dirBit(1), 0, 0, 0, kDiagonals, kOrthogonals, 0, 0, 0, 0, 0, 0, kDiagonals, kOrthogonals,
+};
+
+inline int dirFile(const int i, const uint8_t seat) { return seat == kSente ? kDirFile[i] : -kDirFile[i]; }
+inline int dirRank(const int i, const uint8_t seat) { return seat == kSente ? kDirRank[i] : -kDirRank[i]; }
+
+inline bool ownedBy(const uint8_t cell, const uint8_t seat) { return cell != 0 && ownerOf(cell) == seat; }
+
+void addBoardMove(MoveList& list, const uint8_t type, const int from, const int to, const uint8_t seat) {
+  const int fromRank = rankOf(from);
+  const int toRank = rankOf(to);
+  Move move{static_cast<uint8_t>(from), static_cast<uint8_t>(to), None, 0};
+  if (canPromoteType(type) && (inZone(fromRank, seat) || inZone(toRank, seat))) {
+    move.promote = 1;
+    list.add(move);
+    move.promote = 0;
+  }
+  // A piece that could never move again from `to` must promote, so the
+  // unpromoted version of that move simply does not exist.
+  if (!deadEnd(type, toRank, seat)) list.add(move);
+}
+
+uint8_t fromSfenLetter(const char c, uint8_t& owner) {
+  owner = (c >= 'a' && c <= 'z') ? kGote : kSente;
+  switch (c | 0x20) {
+    case 'p':
+      return Pawn;
+    case 'l':
+      return Lance;
+    case 'n':
+      return Knight;
+    case 's':
+      return Silver;
+    case 'g':
+      return Gold;
+    case 'b':
+      return Bishop;
+    case 'r':
+      return Rook;
+    case 'k':
+      return King;
+    default:
+      return None;
+  }
+}
+
+constexpr char kUsiDrop[8] = {'?', 'P', 'L', 'N', 'S', 'G', 'B', 'R'};
+
+}  // namespace
+
+void start(Board& board) { parseSfen("lnsgkgsnl/1r5b1/ppppppppp/9/9/9/PPPPPPPPP/1B5R1/LNSGKGSNL b - 1", board); }
+
+bool parseSfen(const char* sfen, Board& out) {
+  if (sfen == nullptr) return false;
+  Board board{};
+  const char* c = sfen;
+  int file = 0;
+  int rank = 0;
+  for (; *c != '\0' && *c != ' '; ++c) {
+    if (*c == '/') {
+      if (file != kFiles) return false;
+      ++rank;
+      file = 0;
+      continue;
+    }
+    if (*c >= '1' && *c <= '9') {
+      file += *c - '0';
+      if (file > kFiles) return false;
+      continue;
+    }
+    bool promoted = false;
+    if (*c == '+') {
+      promoted = true;
+      ++c;
+    }
+    uint8_t owner = kSente;
+    uint8_t type = fromSfenLetter(*c, owner);
+    if (type == None || file >= kFiles || rank >= kRanks) return false;
+    if (promoted) {
+      if (!canPromoteType(type)) return false;
+      type = static_cast<uint8_t>(type + 8);
+    }
+    board.cell[indexOf(file, rank)] = makeCell(type, owner);
+    ++file;
+  }
+  if (rank != kRanks - 1 || file != kFiles || *c != ' ') return false;
+  ++c;
+  if (*c == 'b') {
+    board.turn = kSente;
+  } else if (*c == 'w') {
+    board.turn = kGote;
+  } else {
+    return false;
+  }
+  ++c;
+  if (*c != ' ') return false;
+  ++c;
+  if (*c == '-') {
+    ++c;
+  } else {
+    while (*c != '\0' && *c != ' ') {
+      int count = 1;
+      if (*c >= '0' && *c <= '9') {
+        count = 0;
+        while (*c >= '0' && *c <= '9') count = count * 10 + (*c++ - '0');
+      }
+      uint8_t owner = kSente;
+      const uint8_t type = fromSfenLetter(*c, owner);
+      if (type == None || type == King || count <= 0 || count > 18) return false;
+      board.hand[owner][type] = static_cast<uint8_t>(board.hand[owner][type] + count);
+      ++c;
+    }
+  }
+  out = board;
+  return true;
+}
+
+int kingSquare(const Board& board, const uint8_t seat) {
+  const uint8_t king = makeCell(King, seat);
+  for (int i = 0; i < kCells; ++i) {
+    if (board.cell[i] == king) return i;
+  }
+  return -1;
+}
+
+bool isAttacked(const Board& board, const int square, const uint8_t by) {
+  const int sf = fileOf(square);
+  const int sr = rankOf(square);
+  // Steppers: an attacker one step BEHIND the target in direction i attacks it
+  // if its type steps in direction i.
+  for (int i = 0; i < 10; ++i) {
+    const int f = sf - dirFile(i, by);
+    const int r = sr - dirRank(i, by);
+    if (!inside(f, r)) continue;
+    const uint8_t cell = board.cell[indexOf(f, r)];
+    if (ownedBy(cell, by) && (kSteps[typeOf(cell)] & dirBit(i)) != 0) return true;
+  }
+  // Sliders: walk backwards from the target until the first piece.
+  for (int i = 0; i < 8; ++i) {
+    const int df = dirFile(i, by);
+    const int dr = dirRank(i, by);
+    int f = sf - df;
+    int r = sr - dr;
+    while (inside(f, r)) {
+      const uint8_t cell = board.cell[indexOf(f, r)];
+      if (cell != 0) {
+        if (ownedBy(cell, by) && (kSlides[typeOf(cell)] & dirBit(i)) != 0) return true;
+        break;
+      }
+      f -= df;
+      r -= dr;
+    }
+  }
+  return false;
+}
+
+bool inCheck(const Board& board, const uint8_t seat) {
+  const int king = kingSquare(board, seat);
+  return king >= 0 && isAttacked(board, king, other(seat));
+}
+
+void generatePseudo(const Board& board, MoveList& list) {
+  list.clear();
+  const uint8_t seat = board.turn;
+
+  for (int from = 0; from < kCells; ++from) {
+    const uint8_t cell = board.cell[from];
+    if (!ownedBy(cell, seat)) continue;
+    const uint8_t type = typeOf(cell);
+    const int ff = fileOf(from);
+    const int fr = rankOf(from);
+    const uint16_t steps = kSteps[type];
+    const uint16_t slides = kSlides[type];
+    for (int i = 0; i < 10; ++i) {
+      if ((steps & dirBit(i)) == 0) continue;
+      const int f = ff + dirFile(i, seat);
+      const int r = fr + dirRank(i, seat);
+      if (!inside(f, r)) continue;
+      const int to = indexOf(f, r);
+      if (ownedBy(board.cell[to], seat)) continue;
+      addBoardMove(list, type, from, to, seat);
+    }
+    for (int i = 0; i < 8; ++i) {
+      if ((slides & dirBit(i)) == 0) continue;
+      const int df = dirFile(i, seat);
+      const int dr = dirRank(i, seat);
+      int f = ff + df;
+      int r = fr + dr;
+      while (inside(f, r)) {
+        const int to = indexOf(f, r);
+        const uint8_t target = board.cell[to];
+        if (ownedBy(target, seat)) break;
+        addBoardMove(list, type, from, to, seat);
+        if (target != 0) break;
+        f += df;
+        r += dr;
+      }
+    }
+  }
+
+  // Files already holding one of our unpromoted pawns, for nifu.
+  bool pawnOnFile[kFiles] = {};
+  const uint8_t ownPawn = makeCell(Pawn, seat);
+  for (int i = 0; i < kCells; ++i) {
+    if (board.cell[i] == ownPawn) pawnOnFile[fileOf(i)] = true;
+  }
+
+  for (uint8_t type = Pawn; type <= Rook; ++type) {
+    if (board.hand[seat][type] == 0) continue;
+    for (int to = 0; to < kCells; ++to) {
+      if (board.cell[to] != 0) continue;
+      if (deadEnd(type, rankOf(to), seat)) continue;
+      if (type == Pawn && pawnOnFile[fileOf(to)]) continue;
+      list.add(Move{kDropFrom, static_cast<uint8_t>(to), type, 0});
+    }
+  }
+}
+
+void makeMove(Board& board, const Move& move) {
+  const uint8_t seat = board.turn;
+  if (isDrop(move)) {
+    board.cell[move.to] = makeCell(move.drop, seat);
+    --board.hand[seat][move.drop];
+  } else {
+    const uint8_t captured = board.cell[move.to];
+    if (captured != 0) ++board.hand[seat][baseOf(typeOf(captured))];
+    uint8_t type = typeOf(board.cell[move.from]);
+    if (move.promote != 0) type = static_cast<uint8_t>(type + 8);
+    board.cell[move.to] = makeCell(type, seat);
+    board.cell[move.from] = 0;
+  }
+  board.turn = other(seat);
+}
+
+namespace {
+
+// Existence of a legal reply, with the uchifuzume test switched off below the
+// first level. The only question uchifuzume asks of a reply is "is there one",
+// and the answer cannot hinge on another pawn-drop mate one ply deeper: a
+// side in check from a pawn can always answer it some other way if at all.
+bool hasLegalMoveAt(const Board& board, int depth);
+
+bool isLegalAt(const Board& board, const Move& move, const int depth) {
+  Board next = board;
+  makeMove(next, move);
+  const uint8_t mover = board.turn;
+  const int king = kingSquare(next, mover);
+  if (king >= 0 && isAttacked(next, king, next.turn)) return false;
+  // Uchifuzume: a pawn drop that checks must leave the defender a reply.
+  if (isDrop(move) && move.drop == Pawn && depth == 0) {
+    const int theirs = kingSquare(next, next.turn);
+    const int ahead = mover == kSente ? move.to - kFiles : move.to + kFiles;
+    if (theirs >= 0 && theirs == ahead && !hasLegalMoveAt(next, depth + 1)) return false;
+  }
+  return true;
+}
+
+bool hasLegalMoveAt(const Board& board, const int depth) {
+  // Static so neither level puts a 2.4KB list on the stack. Level 0 serves
+  // hasLegalMove(); level 1 serves the uchifuzume question, which never
+  // recurses further. Main thread only: the rules are never asked anything
+  // from the render task.
+  static MoveList lists[2];
+  MoveList& list = lists[depth > 1 ? 1 : depth];
+  generatePseudo(board, list);
+  for (int i = 0; i < list.count; ++i) {
+    if (isLegalAt(board, list.moves[i], depth)) return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+bool isLegal(const Board& board, const Move& move) { return isLegalAt(board, move, 0); }
+
+void generateLegal(const Board& board, MoveList& list) {
+  // Filtered in place: a second 2.4KB list on the stack is the thing the
+  // device cannot afford.
+  generatePseudo(board, list);
+  int kept = 0;
+  for (int i = 0; i < list.count; ++i) {
+    if (isLegal(board, list.moves[i])) list.moves[kept++] = list.moves[i];
+  }
+  list.count = kept;
+}
+
+bool hasLegalMove(const Board& board) { return hasLegalMoveAt(board, 0); }
+
+uint64_t perft(const Board& board, const int depth) {
+  if (depth == 0) return 1;
+  MoveList list;
+  generateLegal(board, list);
+  if (depth == 1) return static_cast<uint64_t>(list.count);
+  uint64_t nodes = 0;
+  for (int i = 0; i < list.count; ++i) {
+    Board next = board;
+    makeMove(next, list.moves[i]);
+    nodes += perft(next, depth - 1);
+  }
+  return nodes;
+}
+
+uint32_t positionKey(const Board& board) {
+  uint32_t hash = 2166136261u;
+  const auto mix = [&hash](const uint8_t byte) {
+    hash ^= byte;
+    hash *= 16777619u;
+  };
+  for (int i = 0; i < kCells; ++i) mix(board.cell[i]);
+  for (int seat = 0; seat < 2; ++seat) {
+    for (int t = 0; t < kHandSlots; ++t) mix(board.hand[seat][t]);
+  }
+  mix(board.turn);
+  return hash;
+}
+
+void moveToUsi(const Move& move, char* out) {
+  int n = 0;
+  if (isDrop(move)) {
+    out[n++] = kUsiDrop[move.drop & 7];
+    out[n++] = '*';
+  } else {
+    out[n++] = static_cast<char>('0' + (kFiles - fileOf(move.from)));
+    out[n++] = static_cast<char>('a' + rankOf(move.from));
+  }
+  out[n++] = static_cast<char>('0' + (kFiles - fileOf(move.to)));
+  out[n++] = static_cast<char>('a' + rankOf(move.to));
+  if (move.promote != 0) out[n++] = '+';
+  out[n] = '\0';
+}
+
+// ---------------------------------------------------------------------------
+
+namespace {
+
+void remember(Game& game) {
+  game.keys[game.keyHead] = positionKey(game.board);
+  game.keyHead = static_cast<uint8_t>((game.keyHead + 1) % kKeyRing);
+  if (game.keyCount < kKeyRing) ++game.keyCount;
+}
+
+}  // namespace
+
+void startGame(Game& game) {
+  game = Game{};
+  start(game.board);
+  game.lastFrom = kNoSquare;
+  game.lastTo = kNoSquare;
+  remember(game);
+}
+
+bool play(Game& game, const Move& move) {
+  // Main-thread scratch, like hasLegalMoveAt's. The rules never run on the
+  // render task: activities cache what a paint needs.
+  static MoveList pseudo;
+  generatePseudo(game.board, pseudo);
+  for (int i = 0; i < pseudo.count; ++i) {
+    if (!sameMove(pseudo.moves[i], move)) continue;
+    if (!isLegal(game.board, move)) return false;
+    makeMove(game.board, move);
+    game.lastFrom = move.from;
+    game.lastTo = move.to;
+    if (game.plies < 0xFFFF) ++game.plies;
+    remember(game);
+    return true;
+  }
+  return false;
+}
+
+int repetitions(const Game& game) {
+  if (game.keyCount == 0) return 0;
+  const uint32_t now = positionKey(game.board);
+  int count = 0;
+  for (int i = 0; i < game.keyCount; ++i) {
+    if (game.keys[i] == now) ++count;
+  }
+  return count;
+}
+
+Outcome outcome(const Game& game) {
+  if (!hasLegalMove(game.board)) return game.board.turn == kSente ? Outcome::GoteWins : Outcome::SenteWins;
+  if (repetitions(game) >= kRepetitionDraw) return Outcome::Draw;
+  if (game.plies >= kMaxPlies) return Outcome::Draw;
+  return Outcome::Running;
+}
+
+}  // namespace shogi
diff --git a/src/apps_local/shogi/ShogiCore.h b/src/apps_local/shogi/ShogiCore.h
new file mode 100644
index 00000000..63c0126b
--- /dev/null
+++ b/src/apps_local/shogi/ShogiCore.h
@@ -0,0 +1,211 @@
+#pragma once
+
+// Shogi, the rules. Freestanding C++17: no Arduino, no renderer, no heap, so
+// the whole ruleset is verified on the host (host-tests/shogi/run.sh) against
+// published perft counts before a single square is drawn.
+//
+// Board: 81 cells, index = rank * 9 + file. Rank 0 is the top row, which is
+// Gote's back rank; Sente (who moves first) sits at the bottom and advances
+// toward rank 0. File 0 is the leftmost column as Sente sees it, which is file
+// 9 in Japanese notation. The SFEN string lists cells in exactly this order.
+//
+// What makes this shogi rather than chess-with-letters, and where the bugs
+// live, is all built into move generation rather than validated afterwards:
+//   - captured pieces change sides and can be DROPPED back on an empty square;
+//   - a dropped pawn may not share a file with your own unpromoted pawn (nifu);
+//   - nothing may be dropped or moved where it could never move again, which
+//     also makes promotion compulsory for pawns, lances and knights there;
+//   - a pawn drop may not deliver checkmate (uchifuzume).
+//
+// Moving into check is illegal, and having no legal move loses -- shogi has no
+// stalemate.
+
+#include <cstdint>
+
+namespace shogi {
+
+constexpr int kFiles = 9;
+constexpr int kRanks = 9;
+constexpr int kCells = kFiles * kRanks;
+
+// Seats. Sente moves first and plays up the board.
+constexpr uint8_t kSente = 0;
+constexpr uint8_t kGote = 1;
+
+// Piece types. A promoted piece is its base type + 8, so promotion and
+// demotion are an add and a subtract. King is 8 and never promotes, and 13
+// (promoted gold) does not exist.
+enum Type : uint8_t {
+  None = 0,
+  Pawn = 1,
+  Lance = 2,
+  Knight = 3,
+  Silver = 4,
+  Gold = 5,
+  Bishop = 6,
+  Rook = 7,
+  King = 8,
+  Tokin = 9,
+  PLance = 10,
+  PKnight = 11,
+  PSilver = 12,
+  Horse = 14,
+  Dragon = 15,
+};
+
+// A cell is a type in the low four bits plus an owner bit.
+constexpr uint8_t kGoteFlag = 0x10;
+constexpr uint8_t kTypeMask = 0x0F;
+
+constexpr uint8_t typeOf(const uint8_t cell) { return cell & kTypeMask; }
+constexpr uint8_t ownerOf(const uint8_t cell) { return (cell & kGoteFlag) != 0 ? kGote : kSente; }
+constexpr uint8_t makeCell(const uint8_t type, const uint8_t owner) {
+  return static_cast<uint8_t>(type | (owner == kGote ? kGoteFlag : 0));
+}
+constexpr bool isPromoted(const uint8_t type) { return type > King; }
+constexpr bool canPromoteType(const uint8_t type) { return type != None && type != Gold && type < King; }
+// What a captured piece becomes in the captor's hand.
+constexpr uint8_t baseOf(const uint8_t type) { return isPromoted(type) ? static_cast<uint8_t>(type - 8) : type; }
+constexpr uint8_t other(const uint8_t seat) { return seat == kSente ? kGote : kSente; }
+
+// Pieces in hand, indexed by base type 1..7 (index 0 unused, so a type IS its
+// index and no caller has to remember an offset).
+constexpr int kHandSlots = 8;
+
+struct Board {
+  uint8_t cell[kCells];
+  uint8_t hand[2][kHandSlots];
+  uint8_t turn;
+};
+
+// `from` is kDropFrom for a drop, in which case `drop` names the base type.
+constexpr uint8_t kDropFrom = 0xFF;
+
+struct Move {
+  uint8_t from;
+  uint8_t to;
+  uint8_t drop;
+  uint8_t promote;
+};
+
+constexpr bool isDrop(const Move& move) { return move.from == kDropFrom; }
+
+inline bool sameMove(const Move& a, const Move& b) {
+  return a.from == b.from && a.to == b.to && a.drop == b.drop && a.promote == b.promote;
+}
+
+// 593 is the most legal moves any shogi position is known to have.
+constexpr int kMaxMoves = 600;
+
+struct MoveList {
+  Move moves[kMaxMoves];
+  int count = 0;
+  void clear() { count = 0; }
+  void add(const Move& move) {
+    if (count < kMaxMoves) moves[count++] = move;
+  }
+};
+
+inline int fileOf(const int index) { return index % kFiles; }
+inline int rankOf(const int index) { return index / kFiles; }
+inline int indexOf(const int file, const int rank) { return rank * kFiles + file; }
+inline bool inside(const int file, const int rank) { return file >= 0 && file < kFiles && rank >= 0 && rank < kRanks; }
+
+// The three ranks nearest the opponent, where promotion becomes possible.
+inline bool inZone(const int rank, const uint8_t seat) { return seat == kSente ? rank <= 2 : rank >= 6; }
+
+// How many ranks from the far edge `rank` is, for `seat`: 0 on the last rank.
+inline int ranksToEdge(const int rank, const uint8_t seat) { return seat == kSente ? rank : kRanks - 1 - rank; }
+
+// True when a piece of `type` standing on `rank` could never move again.
+inline bool deadEnd(const uint8_t type, const int rank, const uint8_t seat) {
+  const int edge = ranksToEdge(rank, seat);
+  if (type == Pawn || type == Lance) return edge == 0;
+  if (type == Knight) return edge <= 1;
+  return false;
+}
+
+void start(Board& board);
+
+// Parses an SFEN record ("lnsgkgsnl/1r5b1/... b - 1"). The move number is
+// optional. Returns false and leaves `board` alone on anything malformed.
+bool parseSfen(const char* sfen, Board& board);
+
+// The square of `seat`'s king, or -1 when it has none (test positions only).
+int kingSquare(const Board& board, uint8_t seat);
+
+// True when any piece of `by` attacks `square`.
+bool isAttacked(const Board& board, int square, uint8_t by);
+
+bool inCheck(const Board& board, uint8_t seat);
+
+// Every move the side to move could make if leaving the king attacked were
+// allowed. Already obeys nifu, dead ends and compulsory promotion; only king
+// safety and uchifuzume are left to isLegal().
+void generatePseudo(const Board& board, MoveList& list);
+
+// Applies a move without asking whether it is legal. Search and legality
+// checks call this on copies.
+void makeMove(Board& board, const Move& move);
+
+// Whether a pseudo-legal move is legal: the mover's king is not left attacked,
+// and a pawn drop does not deliver mate.
+bool isLegal(const Board& board, const Move& move);
+
+void generateLegal(const Board& board, MoveList& list);
+
+// Whether the side to move has any legal move. Uses main-thread scratch lists
+// rather than the stack, so call it from the loop, never from a render.
+bool hasLegalMove(const Board& board);
+
+// Node count at `depth`. The standard correctness measure for a move
+// generator; see host-tests/shogi.
+uint64_t perft(const Board& board, int depth);
+
+// A 32-bit fingerprint of the position (cells, hands, side to move), for
+// repetition. FNV-1a: it is computed once per ply, so there is nothing for an
+// incremental Zobrist table to save.
+uint32_t positionKey(const Board& board);
+
+// USI notation: "7g7f", "8h2b+", "P*5e". `out` must hold 6 bytes.
+void moveToUsi(const Move& move, char* out);
+
+// ---------------------------------------------------------------------------
+// The game: a board plus what it takes to end one. Trivially copyable and
+// under 192 bytes, because it is also the wire format for a two-device match.
+
+// Four occurrences of the same position is sennichite, a draw. Sixteen recent
+// keys catch every repetition a real game produces (a cycle is four plies).
+constexpr int kKeyRing = 16;
+constexpr int kRepetitionDraw = 4;
+// A game that has not ended by here is called a draw (jishogi, simplified).
+constexpr uint16_t kMaxPlies = 400;
+
+constexpr uint8_t kNoSquare = 0xFE;
+
+struct Game {
+  Board board;
+  uint8_t lastFrom;
+  uint8_t lastTo;
+  uint16_t plies;
+  uint8_t keyCount;
+  uint8_t keyHead;
+  uint8_t pad[2];
+  uint32_t keys[kKeyRing];
+};
+
+enum class Outcome : uint8_t { Running, SenteWins, GoteWins, Draw };
+
+void startGame(Game& game);
+
+// Plays `move` only if it is legal here. Refuses anything else, so a stale tap
+// cannot half-apply and desync a two-device match.
+bool play(Game& game, const Move& move);
+
+// How many of the remembered positions equal the current one, itself included.
+int repetitions(const Game& game);
+
+Outcome outcome(const Game& game);
+inline bool over(const Game& game) { return outcome(game) != Outcome::Running; }
+
+}  // namespace shogi
diff --git a/src/apps_local/shogi/ShogiEngine.cpp b/src/apps_local/shogi/ShogiEngine.cpp
new file mode 100644
index 00000000..2e7ff595
--- /dev/null
+++ b/src/apps_local/shogi/ShogiEngine.cpp
@@ -0,0 +1,224 @@
+#include "ShogiEngine.h"
+
+namespace shogi {
+
+namespace {
+
+// On the board. Roughly the values computer shogi converged on (Bonanza's
+// order of magnitude), rounded: a dragon is worth more than a rook and a
+// promoted minor piece about a gold.
+constexpr int kBoardValue[16] = {
+    0,     // None
+    90,    // Pawn
+    315,   // Lance
+    405,   // Knight
+    495,   // Silver
+    540,   // Gold
+    855,   // Bishop
+    990,   // Rook
+    0,     // King (never captured; mate is scored separately)
+    540,   // Tokin
+    540,   // PLance
+    540,   // PKnight
+    540,   // PSilver
+    0,     // 13 does not exist
+    945,   // Horse
+    1395,  // Dragon
+};
+
+// In hand a piece is worth a little more than on the board: it can be dropped
+// anywhere, which is the whole character of the game.
+constexpr int kHandValue[8] = {0, 100, 350, 450, 550, 600, 950, 1100};
+
+struct Context {
+  SearchBuffers& buffers;
+  uint32_t nodes = 0;
+  uint32_t budget = 0;
+  bool stopped = false;
+
+  bool outOfBudget() {
+    if (budget != 0 && nodes >= budget) stopped = true;
+    return stopped;
+  }
+};
+
+// Higher sorts first: captures by most valuable victim, least valuable
+// attacker; then promotions; then quiet moves; drops last. Good ordering is
+// what makes alpha-beta prune, and on this branching factor that is the
+// difference between depth 2 and depth 3.
+int orderScore(const Board& board, const Move& move, const Move* preferred) {
+  if (preferred != nullptr && sameMove(move, *preferred)) return 1000000;
+  if (isDrop(move)) return 0;
+  const uint8_t victim = board.cell[move.to];
+  const uint8_t mover = typeOf(board.cell[move.from]);
+  int score = 100;
+  if (victim != 0) score += 10000 + kBoardValue[typeOf(victim)] * 8 - kBoardValue[mover] / 16;
+  if (move.promote != 0) score += 2000;
+  return score;
+}
+
+void sortMoves(const Board& board, MoveList& list, int* scores, const Move* preferred) {
+  for (int i = 0; i < list.count; ++i) scores[i] = orderScore(board, list.moves[i], preferred);
+  // Insertion sort: stable (so equal scores keep generation order and the
+  // engine stays deterministic) and cheap on lists this size.
+  for (int i = 1; i < list.count; ++i) {
+    const Move move = list.moves[i];
+    const int score = scores[i];
+    int j = i - 1;
+    while (j >= 0 && scores[j] < score) {
+      list.moves[j + 1] = list.moves[j];
+      scores[j + 1] = scores[j];
+      --j;
+    }
+    list.moves[j + 1] = move;
+    scores[j + 1] = score;
+  }
+}
+
+int quiesce(Context& ctx, const Board& board, int alpha, const int beta, const int qply, const int slot) {
+  ++ctx.nodes;
+  const int standPat = evaluate(board);
+  if (qply >= kMaxQuiescence || ctx.outOfBudget()) return standPat;
+  if (standPat >= beta) return standPat;
+  if (standPat > alpha) alpha = standPat;
+
+  MoveList& list = ctx.buffers.plies[slot];
+  generatePseudo(board, list);
+  // Captures only. Keep them in place, then order.
+  int kept = 0;
+  for (int i = 0; i < list.count; ++i) {
+    const Move& m = list.moves[i];
+    if (!isDrop(m) && board.cell[m.to] != 0) list.moves[kept++] = m;
+  }
+  list.count = kept;
+  sortMoves(board, list, ctx.buffers.scores, nullptr);
+
+  for (int i = 0; i < list.count; ++i) {
+    const Move move = list.moves[i];
+    Board next = board;
+    makeMove(next, move);
+    const int king = kingSquare(next, board.turn);
+    if (king >= 0 && isAttacked(next, king, next.turn)) continue;
+    const int score = -quiesce(ctx, next, -beta, -alpha, qply + 1, slot + 1);
+    if (ctx.stopped) return alpha;
+    if (score >= beta) return score;
+    if (score > alpha) alpha = score;
+  }
+  return alpha;
+}
+
+int negamax(Context& ctx, const Board& board, const int depth, int alpha, const int beta, const int ply) {
+  if (depth == 0) return quiesce(ctx, board, alpha, beta, 0, ply);
+  ++ctx.nodes;
+  if (ctx.outOfBudget()) return 0;
+
+  MoveList& list = ctx.buffers.plies[ply];
+  generatePseudo(board, list);
+  sortMoves(board, list, ctx.buffers.scores, nullptr);
+
+  bool any = false;
+  int best = -kMateScore;
+  for (int i = 0; i < list.count; ++i) {
+    const Move move = list.moves[i];
+    if (!isLegal(board, move)) continue;
+    any = true;
+    Board next = board;
+    makeMove(next, move);
+    const int score = -negamax(ctx, next, depth - 1, -beta, -alpha, ply + 1);
+    if (ctx.stopped) return 0;
+    if (score > best) best = score;
+    if (score > alpha) alpha = score;
+    if (alpha >= beta) break;
+  }
+  // No legal move loses in shogi, check or not. Nearer mates score higher.
+  if (!any) return -kMateScore + ply;
+  return best;
+}
+
+}  // namespace
+
+int pieceValue(const uint8_t type) { return kBoardValue[type & kTypeMask]; }
+
+int evaluate(const Board& board) {
+  int score[2] = {0, 0};
+  int kingAt[2] = {-1, -1};
+  for (int i = 0; i < kCells; ++i) {
+    const uint8_t cell = board.cell[i];
+    if (cell == 0) continue;
+    const uint8_t owner = ownerOf(cell);
+    const uint8_t type = typeOf(cell);
+    score[owner] += kBoardValue[type];
+    if (type == King) kingAt[owner] = i;
+    // A pawn or silver pressing forward is worth a few points more.
+    if (type == Pawn || type == Silver) score[owner] += 3 * (kRanks - 1 - ranksToEdge(rankOf(i), owner));
+  }
+  for (int seat = 0; seat < 2; ++seat) {
+    for (int t = Pawn; t <= Rook; ++t) score[seat] += kHandValue[t] * board.hand[seat][t];
+  }
+  // Shelter: golds and silvers next to their own king.
+  for (int seat = 0; seat < 2; ++seat) {
+    if (kingAt[seat] < 0) continue;
+    const int kf = fileOf(kingAt[seat]);
+    const int kr = rankOf(kingAt[seat]);
+    for (int df = -1; df <= 1; ++df) {
+      for (int dr = -1; dr <= 1; ++dr) {
+        if (!inside(kf + df, kr + dr) || (df == 0 && dr == 0)) continue;
+        const uint8_t cell = board.cell[indexOf(kf + df, kr + dr)];
+        if (cell == 0 || ownerOf(cell) != seat) continue;
+        const uint8_t type = typeOf(cell);
+        if (type == Gold || type == Silver || (type >= Tokin && type <= PSilver)) score[seat] += 25;
+      }
+    }
+  }
+  const int mine = board.turn;
+  return score[mine] - score[other(static_cast<uint8_t>(mine))];
+}
+
+SearchResult search(const Board& board, const int maxDepth, SearchBuffers& buffers, const uint32_t nodeBudget) {
+  SearchResult result;
+  Context ctx{buffers};
+  ctx.budget = nodeBudget;
+
+  // The root list lives in the last slot, which the search below never reaches
+  // (main plies + quiescence plies < slot count), so iterating it is safe while
+  // the children reuse the others.
+  MoveList& root = buffers.plies[kMaxSearchDepth + kMaxQuiescence];
+  generateLegal(board, root);
+  if (root.count == 0) return result;
+  result.hasMove = true;
+  result.best = root.moves[0];
+
+  const int depthCap = maxDepth < 1 ? 1 : (maxDepth > kMaxSearchDepth ? kMaxSearchDepth : maxDepth);
+  for (int depth = 1; depth <= depthCap; ++depth) {
+    const Move preferred = result.best;
+    sortMoves(board, root, buffers.scores, &preferred);
+    int alpha = -kMateScore - 1;
+    const int beta = kMateScore + 1;
+    Move bestHere = root.moves[0];
+    int bestScore = -kMateScore - 1;
+    for (int i = 0; i < root.count; ++i) {
+      Board next = board;
+      makeMove(next, root.moves[i]);
+      const int score = -negamax(ctx, next, depth - 1, -beta, -alpha, 1);
+      if (ctx.stopped) break;
+      if (score > bestScore) {
+        bestScore = score;
+        bestHere = root.moves[i];
+      }
+      if (score > alpha) alpha = score;
+    }
+    if (ctx.stopped) {
+      result.budgetExhausted = true;
+      break;
+    }
+    result.best = bestHere;
+    result.score = bestScore;
+    result.depthCompleted = depth;
+    // A forced mate found: deeper search cannot improve on it.
+    if (bestScore >= kMateThreshold) break;
+  }
+  result.nodes = ctx.nodes;
+  return result;
+}
+
+}  // namespace shogi
diff --git a/src/apps_local/shogi/ShogiEngine.h b/src/apps_local/shogi/ShogiEngine.h
new file mode 100644
index 00000000..5284a8b2
--- /dev/null
+++ b/src/apps_local/shogi/ShogiEngine.h
@@ -0,0 +1,60 @@
+#pragma once
+
+// The built-in Shogi opponent: iterative-deepening alpha-beta over ShogiCore,
+// with a capture-only quiescence search so it does not stop counting in the
+// middle of an exchange.
+//
+// Freestanding like the rules, so it is host-tested. Bounded by a NODE budget
+// rather than a clock: node counts are deterministic, so a test can assert on
+// them and the same budget plays the same move on every device -- which also
+// keeps a position reconstructible.
+//
+// Copy-make throughout. A Board is 98 bytes, so copying one per node is cheaper
+// than an unmake that has to remember hand counts and promotions, and it means
+// the search can never hand back a board it forgot to restore.
+
+#include <cstdint>
+
+#include "ShogiCore.h"
+
+namespace shogi {
+
+constexpr int kMateScore = 30000;
+constexpr int kMateThreshold = kMateScore - 1000;
+
+// Main-search plies, and quiescence plies beyond them. Each costs one 2.4KB
+// MoveList in SearchBuffers.
+constexpr int kMaxSearchDepth = 4;
+constexpr int kMaxQuiescence = 4;
+
+// Owned by the caller (the activity holds one as a member), so the engine
+// allocates nothing and nothing large lands on a task stack.
+struct SearchBuffers {
+  MoveList plies[kMaxSearchDepth + kMaxQuiescence + 1];
+  int scores[kMaxMoves];
+};
+
+struct SearchResult {
+  Move best{};
+  int score = 0;
+  uint32_t nodes = 0;
+  int depthCompleted = 0;
+  bool budgetExhausted = false;
+  bool hasMove = false;
+};
+
+// Material and a little king shelter, in centipawn-like units, from the
+// side-to-move's point of view.
+int evaluate(const Board& board);
+
+// The value of one piece of `type` on the board.
+int pieceValue(uint8_t type);
+
+// Best move for the side to move, searching depth 1, 2, ... up to `maxDepth`
+// while `nodeBudget` lasts (0 means no budget). Returns the best move of the
+// deepest COMPLETED iteration, so running out of budget never returns a move
+// that was only half considered. hasMove is false only when there is no legal
+// move at all.
+SearchResult search(const Board& board, int maxDepth, SearchBuffers& buffers, uint32_t nodeBudget);
+
+}  // namespace shogi
diff --git a/src/apps_local/shogi/ShogiFlow.h b/src/apps_local/shogi/ShogiFlow.h
new file mode 100644
index 00000000..aa064383
--- /dev/null
+++ b/src/apps_local/shogi/ShogiFlow.h
@@ -0,0 +1,149 @@
+#pragma once
+
+// Shogi's navigation, and the state that lives between two taps. Freestanding.
+//
+// A shogi move is two taps -- a piece (on the board OR in your hand) and then a
+// destination -- and sometimes three, when the rules let the piece choose
+// whether to promote. Everything here reads the rules' own legal move list
+// rather than reasoning about pieces, so a square the UI marks is always a
+// square the rules will accept, and a promotion question is only ever asked
+// when both answers are legal.
+
+#include <cstdint>
+
+#include "ShogiCore.h"
+
+namespace shogi {
+
+enum class Screen : uint8_t {
+  // The top. Back from here leaves the app, and it is the only screen that does.
+  Menu,
+  HowTo,
+  Board,
+  Result,
+};
+
+constexpr Screen back(const Screen screen) {
+  switch (screen) {
+    case Screen::Menu:
+      return Screen::Menu;
+    case Screen::HowTo:
+    case Screen::Board:
+    case Screen::Result:
+      return Screen::Menu;
+  }
+  return Screen::Menu;
+}
+
+constexpr bool leavesApp(const Screen screen) { return screen == Screen::Menu; }
+
+// Who the other side is. A link match is not a mode here: LinkActivity owns it
+// and the activity asks inMatch().
+enum class Opponent : uint8_t { Computer = 0, Friend = 1 };
+
+// What is in hand between the first tap and the second.
+struct Pick {
+  // kNoPick, a board square, or kDropFrom with `drop` naming the hand piece.
+  uint8_t from = kNoPick;
+  uint8_t drop = None;
+
+  static constexpr uint8_t kNoPick = 0xFD;
+  bool any() const { return from != kNoPick; }
+  bool fromHand() const { return from == kDropFrom; }
+};
+
+// How a landing square relates to promotion.
+enum class Promotion : uint8_t {
+  None = 0,      // only the unpromoted move exists
+  Optional = 1,  // both exist: the player is asked
+  Forced = 2,    // only the promoted move exists
+};
+
+struct Targets {
+  uint8_t to[kCells];
+  Promotion promotion[kCells];
+  bool capture[kCells];
+  int count = 0;
+};
+
+inline bool picks(const Pick& pick, const Move& move) {
+  if (pick.fromHand()) return isDrop(move) && move.drop == pick.drop;
+  return !isDrop(move) && move.from == pick.from;
+}
+
+// Every square the picked piece may land on, deduplicated, with whether that
+// landing promotes. Derived from the legal list, never recomputed.
+inline void targetsFor(const Board& board, const MoveList& legal, const Pick& pick, Targets& out) {
+  out.count = 0;
+  if (!pick.any()) return;
+  // Per square: bit 0 = an unpromoted move exists, bit 1 = a promoted one.
+  uint8_t seen[kCells] = {};
+  for (int i = 0; i < legal.count; ++i) {
+    const Move& move = legal.moves[i];
+    if (!picks(pick, move)) continue;
+    seen[move.to] = static_cast<uint8_t>(seen[move.to] | (move.promote != 0 ? 2 : 1));
+  }
+  for (int square = 0; square < kCells; ++square) {
+    if (seen[square] == 0) continue;
+    out.to[out.count] = static_cast<uint8_t>(square);
+    out.promotion[out.count] =
+        seen[square] == 3 ? Promotion::Optional : (seen[square] == 2 ? Promotion::Forced : Promotion::None);
+    out.capture[out.count] = board.cell[square] != 0;
+    ++out.count;
+  }
+}
+
+// How a landing on `to` stands on promotion, or false when it is not a target.
+inline bool promotionAt(const Targets& targets, const int to, Promotion& out) {
+  for (int i = 0; i < targets.count; ++i) {
+    if (targets.to[i] != to) continue;
+    out = targets.promotion[i];
+    return true;
+  }
+  return false;
+}
+
+// The legal move for this pick, destination and promotion answer, or false.
+// The caller never builds a Move itself, so a move the rules did not offer
+// cannot be expressed at the boundary.
+inline bool moveFor(const MoveList& legal, const Pick& pick, const int to, const bool promote, Move& out) {
+  for (int i = 0; i < legal.count; ++i) {
+    const Move& move = legal.moves[i];
+    if (!picks(pick, move) || move.to != to) continue;
+    if ((move.promote != 0) != promote) continue;
+    out = move;
+    return true;
+  }
+  return false;
+}
+
+// Whether the piece on `square` (or the hand piece `drop`) has any legal move.
+// A piece that cannot move cannot be lifted, so a tap on it changes nothing.
+inline bool canPickSquare(const MoveList& legal, const int square) {
+  for (int i = 0; i < legal.count; ++i) {
+    if (!isDrop(legal.moves[i]) && legal.moves[i].from == square) return true;
+  }
+  return false;
+}
+
+inline bool canPickHand(const MoveList& legal, const uint8_t drop) {
+  for (int i = 0; i < legal.count; ++i) {
+    if (isDrop(legal.moves[i]) && legal.moves[i].drop == drop) return true;
+  }
+  return false;
+}
+
+// The hand strip's order, most valuable first, as printed sets lay them out.
+constexpr uint8_t kHandOrder[7] = {Rook, Bishop, Gold, Silver, Knight, Lance, Pawn};
+constexpr int kHandOrderCount = 7;
+
+// How the game ended, for the result screen's second line.
+enum class Ending : uint8_t { None, Checkmate, NoMoves, Repetition, MoveLimit };
+
+inline Ending endingOf(const Game& game, const Outcome result) {
+  if (result == Outcome::Running) return Ending::None;
+  if (result == Outcome::Draw) return game.plies >= kMaxPlies ? Ending::MoveLimit : Ending::Repetition;
+  return inCheck(game.board, game.board.turn) ? Ending::Checkmate : Ending::NoMoves;
+}
+
+}  // namespace shogi
diff --git a/src/apps_local/shogi/ShogiSave.h b/src/apps_local/shogi/ShogiSave.h
new file mode 100644
index 00000000..534c986f
--- /dev/null
+++ b/src/apps_local/shogi/ShogiSave.h
@@ -0,0 +1,131 @@
+#pragma once
+
+// Shogi's save file, as a freestanding pack/unpack pair so the round trip is
+// host-tested. One text line:
+//
+//   SHOGI1 <wins> <losses> <draws> <inProgress> <opponent> <seat> <hex of Game>
+//
+// The game travels as the raw bytes of `Game` in hex: it is trivially copyable
+// and already the wire format, so there is exactly one serialisation of a
+// position in this app. A different struct size is a different file version
+// and is refused; unpack also refuses a board the rules could not have
+// produced, so a corrupt card falls back to the menu rather than to a
+// half-drawn game.
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include "ShogiCore.h"
+#include "ShogiFlow.h"
+
+namespace shogisave {
+
+constexpr char kMagic[] = "SHOGI1";
+constexpr int kMaxLine = 64 + static_cast<int>(sizeof(shogi::Game)) * 2;
+
+struct Save {
+  int wins = 0;
+  int losses = 0;
+  int draws = 0;
+  bool inProgress = false;
+  shogi::Opponent opponent = shogi::Opponent::Computer;
+  uint8_t seat = shogi::kSente;
+  shogi::Game game{};
+};
+
+// Whether a board is one a game could actually reach: one king each, no more
+// pieces of a kind than the set holds, a sane side to move.
+inline bool plausible(const shogi::Game& game) {
+  // Qualified rather than `using namespace shogi`: the device build has a global
+  // `None` of its own, and the using-directive made every bare None ambiguous
+  // there while the host build, which never sees that header, compiled clean.
+  namespace g = shogi;
+  if (game.board.turn > g::kGote) return false;
+  if (game.keyCount > g::kKeyRing || game.keyHead >= g::kKeyRing) return false;
+  static constexpr int kSet[8] = {0, 18, 4, 4, 4, 4, 2, 2};
+  int count[8] = {};
+  int kings[2] = {};
+  for (int i = 0; i < g::kCells; ++i) {
+    const uint8_t cell = game.board.cell[i];
+    if (cell == 0) continue;
+    if ((cell & ~(g::kTypeMask | g::kGoteFlag)) != 0) return false;
+    const uint8_t type = g::typeOf(cell);
+    if (type == g::None || type == 13) return false;
+    if (type == g::King) {
+      ++kings[g::ownerOf(cell)];
+      continue;
+    }
+    ++count[g::baseOf(type)];
+  }
+  for (int seat = 0; seat < 2; ++seat) {
+    if (game.board.hand[seat][0] != 0) return false;
+    for (int t = 1; t < g::kHandSlots; ++t) count[t] += game.board.hand[seat][t];
+  }
+  if (kings[0] != 1 || kings[1] != 1) return false;
+  for (int t = 1; t < g::kHandSlots; ++t) {
+    if (count[t] > kSet[t]) return false;
+  }
+  return true;
+}
+
+// Writes the line (with a trailing newline) into `out`. Returns the byte count,
+// or 0 when it would not fit.
+inline int pack(const Save& save, char* out, const int capacity) {
+  int used =
+      std::snprintf(out, static_cast<size_t>(capacity), "%s %d %d %d %d %d %d ", kMagic, save.wins, save.losses,
+                    save.draws, save.inProgress ? 1 : 0, static_cast<int>(save.opponent), static_cast<int>(save.seat));
+  if (used <= 0 || used >= capacity) return 0;
+  const auto* bytes = reinterpret_cast<const uint8_t*>(&save.game);
+  static constexpr char kHex[] = "0123456789abcdef";
+  for (size_t i = 0; i < sizeof(shogi::Game); ++i) {
+    if (used + 3 >= capacity) return 0;
+    out[used++] = kHex[bytes[i] >> 4];
+    out[used++] = kHex[bytes[i] & 15];
+  }
+  out[used++] = '\n';
+  out[used] = '\0';
+  return used;
+}
+
+inline int hexValue(const char c) {
+  if (c >= '0' && c <= '9') return c - '0';
+  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+  return -1;
+}
+
+// Parses a line written by pack(). Commits to `out` only when the whole line is
+// good; otherwise returns false and leaves `out` untouched.
+inline bool unpack(const char* line, Save& out) {
+  if (line == nullptr || std::strncmp(line, kMagic, sizeof(kMagic) - 1) != 0) return false;
+  int wins = 0, losses = 0, draws = 0, inProgress = 0, opponent = 0, seat = 0, consumed = 0;
+  if (std::sscanf(line + sizeof(kMagic) - 1, " %d %d %d %d %d %d %n", &wins, &losses, &draws, &inProgress, &opponent,
+                  &seat, &consumed) != 6) {
+    return false;
+  }
+  if (wins < 0 || losses < 0 || draws < 0 || (inProgress != 0 && inProgress != 1)) return false;
+  if (opponent != 0 && opponent != 1) return false;
+  if (seat != shogi::kSente && seat != shogi::kGote) return false;
+  const char* hex = line + sizeof(kMagic) - 1 + consumed;
+  Save parsed;
+  auto* bytes = reinterpret_cast<uint8_t*>(&parsed.game);
+  for (size_t i = 0; i < sizeof(shogi::Game); ++i) {
+    const int hi = hexValue(hex[i * 2]);
+    const int lo = hi < 0 ? -1 : hexValue(hex[i * 2 + 1]);
+    if (hi < 0 || lo < 0) return false;
+    bytes[i] = static_cast<uint8_t>(hi * 16 + lo);
+  }
+  const char tail = hex[sizeof(shogi::Game) * 2];
+  if (tail != '\0' && tail != '\n' && tail != '\r') return false;
+  if (!plausible(parsed.game)) return false;
+  parsed.wins = wins;
+  parsed.losses = losses;
+  parsed.draws = draws;
+  parsed.inProgress = inProgress == 1;
+  parsed.opponent = static_cast<shogi::Opponent>(opponent);
+  parsed.seat = static_cast<uint8_t>(seat);
+  out = parsed;
+  return true;
+}
+
+}  // namespace shogisave
diff --git a/src/apps_local/shogi/ShogiScreens.cpp b/src/apps_local/shogi/ShogiScreens.cpp
new file mode 100644
index 00000000..3dc42295
--- /dev/null
+++ b/src/apps_local/shogi/ShogiScreens.cpp
@@ -0,0 +1,475 @@
+#include "ShogiScreens.h"
+
+#include <cstdio>
+
+#include "../link/LinkScreens.h"
+#include "../ui/ToyboxFormat.h"
+
+namespace shogiui {
+
+namespace {
+
+namespace sh = shogi;
+
+// 48px squares: nine of them are 432px, which leaves the 24px side margins the
+// rest of the fork uses and room for a hand strip above and below.
+constexpr int16_t kSquare = 48;
+constexpr int16_t kBoardSide = kSquare * sh::kFiles;
+constexpr int16_t kHandHeight = 48;
+constexpr int16_t kHandSlotWidth = kBoardSide / sh::kHandOrderCount;
+
+int16_t boardLeft(const fui::DeviceContext& device) { return static_cast<int16_t>((device.width - kBoardSide) / 2); }
+
+int16_t topHandTop() { return static_cast<int16_t>(toybox::kChromeHeight + toybox::kGutter); }
+
+int16_t boardTop() { return static_cast<int16_t>(topHandTop() + kHandHeight + toybox::kGutter + toybox::kBoardFrame); }
+
+int16_t bottomHandTop() {
+  return static_cast<int16_t>(boardTop() + kBoardSide + toybox::kBoardFrame + toybox::kGutter);
+}
+
+int16_t capsuleTop() { return static_cast<int16_t>(bottomHandTop() + kHandHeight + toybox::kGutter * 2); }
+
+// The header band with the offset rule under it, as checkers wears it.
+void toyboxChrome(toybox::Screen& screen, const char* title, const char* rightLabel = nullptr) {
+  fui::HeaderProps header;
+  header.title = title;
+  header.rightLabel = rightLabel;
+  // rightLabel is drawn with subtitleText, whose theme default is black on the
+  // black band. See the checkers/jaipur toyboxChrome.
+  header.subtitleText = fui::TextStyle{};
+  header.subtitleText.font = toybox::kUiFont;
+  header.subtitleText.color = fui::Color::White;
+  header.subtitleText.align = fui::TextAlign::Right;
+  header.borderEdges = fui::EdgesNone;
+  toybox::absoluteChrome(screen);
+  toybox::headerBand(screen, header);
+  screen.insetContent(fui::Insets{toybox::kGutter * 3, toybox::kMargin, toybox::kMargin, toybox::kMargin});
+}
+
+// A filled pentagon -- the shape of a shogi piece -- pointing up or down. Built
+// from solid triangles, because that is all the target's polygon path draws.
+void pentagonFill(toybox::Screen& screen, const fui::Rect& box, const bool up, const fui::Color colour) {
+  const fui::Paint paint = fui::Paint::solid(colour);
+  const int16_t inset = static_cast<int16_t>(box.width / 7);
+  const int16_t shoulder = static_cast<int16_t>(box.height * 3 / 10);
+  const int16_t cx = static_cast<int16_t>(box.x + box.width / 2);
+  const int16_t top = box.y;
+  const int16_t bottom = static_cast<int16_t>(box.y + box.height);
+  const int16_t left = box.x;
+  const int16_t right = static_cast<int16_t>(box.x + box.width);
+  const int16_t tip = up ? top : bottom;
+  const int16_t shoulderY = up ? static_cast<int16_t>(top + shoulder) : static_cast<int16_t>(bottom - shoulder);
+  const int16_t baseY = up ? bottom : top;
+  const fui::Point apex{cx, tip};
+  const fui::Point sL{static_cast<int16_t>(left + inset), shoulderY};
+  const fui::Point sR{static_cast<int16_t>(right - inset), shoulderY};
+  const fui::Point bL{left, baseY};
+  const fui::Point bR{right, baseY};
+  screen.target().triangle(apex, sL, sR, paint);
+  screen.target().triangle(sL, sR, bR, paint);
+  screen.target().triangle(sL, bR, bL, paint);
+}
+
+// One piece in `box`. The owner reads twice over: by which way it points (at
+// the opponent, as on a real board) and by its colour (the bottom player's
+// pieces are paper, the top player's are ink).
+void drawPiece(toybox::Screen& screen, const fui::Rect& box, const uint8_t type, const bool pointsUp, const bool inked,
+               const toybox::CutMetrics& cut, const fui::FontId font) {
+  pentagonFill(screen, box, pointsUp, fui::Color::Black);
+  if (!inked) {
+    const fui::Rect inner = fui::makeRect(static_cast<int16_t>(box.x + 3), static_cast<int16_t>(box.y + 3),
+                                          static_cast<int16_t>(box.width - 6), static_cast<int16_t>(box.height - 6));
+    pentagonFill(screen, inner, pointsUp, fui::Color::White);
+  }
+  // The label sits in the wide part of the pentagon, away from the point.
+  const int16_t labelTop = pointsUp ? static_cast<int16_t>(box.y + box.height / 4) : box.y;
+  const fui::Rect labelBox = fui::makeRect(box.x, labelTop, box.width, static_cast<int16_t>(box.height * 3 / 4));
+  fui::TextStyle style;
+  style.font = font;
+  style.align = fui::TextAlign::Center;
+  style.color = inked ? fui::Color::White : fui::Color::Black;
+  screen.target().text(toybox::inkCentred(labelBox, cut), pieceLabel(type), style);
+}
+
+fui::Rect pieceBox(const fui::Rect& square) {
+  return fui::makeRect(static_cast<int16_t>(square.x + 4), static_cast<int16_t>(square.y + 3),
+                       static_cast<int16_t>(square.width - 8), static_cast<int16_t>(square.height - 6));
+}
+
+void drawHand(toybox::Screen& screen, const fui::DeviceContext& device, const sh::Board& board, const uint8_t owner,
+              const bool bottom, const uint8_t pickedDrop) {
+  const bool inked = !bottom;
+  for (int slot = 0; slot < sh::kHandOrderCount; ++slot) {
+    const uint8_t type = sh::kHandOrder[slot];
+    const int count = board.hand[owner][type];
+    if (count == 0) continue;
+    const fui::Rect cell = handSlotRect(device, bottom, slot);
+    const fui::Rect box = fui::makeRect(static_cast<int16_t>(cell.x + 4), static_cast<int16_t>(cell.y + 4), 34,
+                                        static_cast<int16_t>(cell.height - 8));
+    drawPiece(screen, box, type, bottom, inked, toybox::kButtonCut, toybox::kSmallFont);
+    if (count > 1) {
+      char n[4];
+      std::snprintf(n, sizeof(n), "%d", count > 99 ? 99 : count);
+      fui::TextStyle style;
+      style.font = toybox::kSmallFont;
+      style.align = fui::TextAlign::Left;
+      const fui::Rect countBox = fui::makeRect(static_cast<int16_t>(box.x + box.width + 3), cell.y,
+                                               static_cast<int16_t>(cell.width - box.width - 7), cell.height);
+      screen.target().text(toybox::inkCentred(countBox, toybox::kTileCut), n, style);
+    }
+    if (bottom && pickedDrop == type) {
+      screen.target().stroke(cell, fui::Paint::solid(fui::Color::Black), toybox::kFrame);
+    }
+  }
+}
+
+}  // namespace
+
+const char* pieceLabel(const uint8_t type) {
+  switch (type) {
+    case sh::Pawn:
+      return "P";
+    case sh::Lance:
+      return "L";
+    case sh::Knight:
+      return "N";
+    case sh::Silver:
+      return "S";
+    case sh::Gold:
+      return "G";
+    case sh::Bishop:
+      return "B";
+    case sh::Rook:
+      return "R";
+    case sh::King:
+      return "K";
+    case sh::Tokin:
+      return "+P";
+    case sh::PLance:
+      return "+L";
+    case sh::PKnight:
+      return "+N";
+    case sh::PSilver:
+      return "+S";
+    case sh::Horse:
+      return "+B";
+    case sh::Dragon:
+      return "+R";
+    default:
+      return "";
+  }
+}
+
+fui::Rect squareRect(const fui::DeviceContext& device, const int file, const int rank, const uint8_t seat) {
+  const int drawFile = seat == sh::kSente ? file : sh::kFiles - 1 - file;
+  const int drawRank = seat == sh::kSente ? rank : sh::kRanks - 1 - rank;
+  return fui::makeRect(static_cast<int16_t>(boardLeft(device) + drawFile * kSquare),
+                       static_cast<int16_t>(boardTop() + drawRank * kSquare), kSquare, kSquare);
+}
+
+bool squareAt(const fui::DeviceContext& device, const int x, const int y, const uint8_t seat, int& file, int& rank) {
+  const int dx = x - boardLeft(device);
+  const int dy = y - boardTop();
+  if (dx < 0 || dy < 0 || dx >= kBoardSide || dy >= kBoardSide) return false;
+  const int drawFile = dx / kSquare;
+  const int drawRank = dy / kSquare;
+  file = seat == sh::kSente ? drawFile : sh::kFiles - 1 - drawFile;
+  rank = seat == sh::kSente ? drawRank : sh::kRanks - 1 - drawRank;
+  return true;
+}
+
+fui::Rect handSlotRect(const fui::DeviceContext& device, const bool bottom, const int slot) {
+  return fui::makeRect(static_cast<int16_t>(boardLeft(device) + slot * kHandSlotWidth),
+                       bottom ? bottomHandTop() : topHandTop(), kHandSlotWidth, kHandHeight);
+}
+
+bool handSlotAt(const fui::DeviceContext& device, const int x, const int y, bool& bottom, int& slot) {
+  const int dx = x - boardLeft(device);
+  if (dx < 0 || dx >= kHandSlotWidth * sh::kHandOrderCount) return false;
+  if (y >= topHandTop() && y < topHandTop() + kHandHeight) {
+    bottom = false;
+  } else if (y >= bottomHandTop() && y < bottomHandTop() + kHandHeight) {
+    bottom = true;
+  } else {
+    return false;
+  }
+  slot = dx / kHandSlotWidth;
+  return true;
+}
+
+fui::Rect promoteRect(const fui::DeviceContext& device) {
+  const int16_t width = static_cast<int16_t>((kBoardSide - toybox::kGutter) / 2);
+  return fui::makeRect(boardLeft(device), capsuleTop(), width, toybox::kPillHeight);
+}
+
+fui::Rect keepRect(const fui::DeviceContext& device) {
+  const fui::Rect left = promoteRect(device);
+  return fui::makeRect(static_cast<int16_t>(left.x + left.width + toybox::kGutter), left.y, left.width, left.height);
+}
+
+int howToPages() { return 4; }
+
+void buildMenu(toybox::Screen& screen, const MenuModel& model) {
+  toyboxChrome(screen, "SHOGI");
+
+  char record[48];
+  std::snprintf(record, sizeof(record), "%d PLAYED   %d WON", model.wins + model.losses + model.draws, model.wins);
+  const fui::Rect line = screen.takeTop(26);
+  fui::TextStyle small;
+  small.font = toybox::kTileFont;
+  small.align = fui::TextAlign::Left;
+  screen.target().text(line, record, small);
+  screen.target().fill(fui::makeRect(line.x, static_cast<int16_t>(line.bottom() + 6), line.width, toybox::kRule),
+                       fui::Paint::solid(fui::Color::Black));
+
+  fui::ListItem rows[static_cast<int>(MenuRow::Count)] = {};
+  int count = 0;
+  int nearbyIndex = -1;
+  const auto add = [&](const MenuRow row, const char* label) {
+    rows[count].label = label;
+    rows[count].actionValue = static_cast<int16_t>(row);
+    ++count;
+  };
+  if (model.canContinue) add(MenuRow::Continue, "CONTINUE");
+  add(MenuRow::Computer, "PLAY THE COMPUTER");
+  add(MenuRow::Friend, "TWO PLAYERS");
+  nearbyIndex = count;
+  add(MenuRow::Nearby, "PLAY NEARBY");
+  rows[nearbyIndex].subtitle = model.nearbyName;
+  add(MenuRow::HowTo, "HOW TO PLAY");
+
+  fui::ListProps list;
+  list.items = rows;
+  list.count = static_cast<uint16_t>(count);
+  list.selectedIndex = 0;
+  list.action = ActionMenuRow;
+  const int16_t listHeight =
+      static_cast<int16_t>(count * toybox::kRowHeight + (count - 1) * toybox::kGutter / 2 + toybox::kGutter);
+  const fui::Rect content = screen.contentRect();
+  const fui::Rect listBand =
+      fui::makeRect(content.x, static_cast<int16_t>(content.bottom() - listHeight), content.width, listHeight);
+  screen.list(list, listHeight, fui::LayoutAnchor::Bottom);
+  toybox::iconAtRowRight(screen, listBand, nearbyIndex, 0, linkui::nearbyMark(), nearbyIndex == 0);
+
+  // The ornament: the opening position's two kings and their golds, drawn with
+  // the board's own pieces, so the front door is made of the game's material.
+  const int16_t areaTop = static_cast<int16_t>(line.bottom() + 6 + toybox::kRule);
+  const int16_t room = static_cast<int16_t>(listBand.y - areaTop);
+  if (room < 140) return;
+  constexpr int16_t kW = 58;
+  constexpr int16_t kH = 64;
+  const int16_t rowW = static_cast<int16_t>(kW * 3 + toybox::kGutter * 2);
+  const fui::DeviceContext device = screen.device();
+  const int16_t left = static_cast<int16_t>((device.width - rowW) / 2);
+  const int16_t top = static_cast<int16_t>(areaTop + (room - kH * 2 - toybox::kGutter) / 2);
+  const uint8_t ornament[3] = {sh::Gold, sh::King, sh::Gold};
+  for (int i = 0; i < 3; ++i) {
+    const int16_t x = static_cast<int16_t>(left + i * (kW + toybox::kGutter));
+    drawPiece(screen, fui::makeRect(x, top, kW, kH), ornament[i], false, true, toybox::kUiCut, toybox::kUiFont);
+    drawPiece(screen, fui::makeRect(x, static_cast<int16_t>(top + kH + toybox::kGutter), kW, kH), ornament[i], true,
+              false, toybox::kUiCut, toybox::kUiFont);
+  }
+}
+
+namespace {
+
+void doBuildHowTo(toybox::Screen& screen, const HowToModel& model) {
+  const int pages = howToPages();
+  const int page = model.page < 0 ? 0 : (model.page >= pages ? pages - 1 : model.page);
+
+  char progress[toybox::kOfCounterChars];
+  std::snprintf(progress, sizeof(progress), "%d OF %d", page + 1, pages);
+  toyboxChrome(screen, "HOW TO PLAY", progress);
+  const fui::Rect body = screen.body();
+  screen.frame().hit(body, ActionHowToNext, 0);
+
+  constexpr int16_t kDot = 14;
+  constexpr int16_t kDotGap = 10;
+  const int16_t dotRow = static_cast<int16_t>(pages * kDot + (pages - 1) * kDotGap);
+  const int16_t dotX = static_cast<int16_t>(body.x + (body.width - dotRow) / 2);
+  const int16_t dotY = static_cast<int16_t>(body.bottom() - kDot);
+  for (int i = 0; i < pages; ++i) {
+    const fui::Rect dotAt = fui::makeRect(static_cast<int16_t>(dotX + i * (kDot + kDotGap)), dotY, kDot, kDot);
+    if (i == page) {
+      screen.target().fill(dotAt, fui::Paint::solid(fui::Color::Black), 7);
+    } else {
+      screen.target().stroke(dotAt, fui::Paint::dither(fui::Color::DarkGray), toybox::kHairline, 7);
+    }
+  }
+  fui::TextStyle tapLine;
+  tapLine.font = toybox::kTileFont;
+  tapLine.align = fui::TextAlign::Center;
+  screen.target().text(fui::makeRect(body.x, static_cast<int16_t>(dotY - 34), body.width, 22),
+                       page + 1 == pages ? "TAP TO FINISH" : "TAP TO CONTINUE", tapLine);
+
+  static const char* const kTitles[] = {"THE PIECES", "PROMOTION", "DROPS", "WINNING"};
+  fui::TextStyle title;
+  title.font = toybox::kDisplayFont;
+  title.align = fui::TextAlign::Center;
+  screen.target().text(toybox::inkCentred(fui::makeRect(body.x, body.y, body.width, 46), toybox::kDisplayCut),
+                       kTitles[page], title);
+
+  static const char* const kLines[] = {
+      "K KING ONE STEP ANY WAY. R ROOK AND B BISHOP SLIDE. G GOLD AND S SILVER STEP. "
+      "N KNIGHT JUMPS TWO FORWARD ONE ACROSS. L LANCE SLIDES FORWARD. P PAWN STEPS FORWARD.",
+      "ENTER, LEAVE OR MOVE IN THE FAR THREE ROWS AND A PIECE MAY PROMOTE. "
+      "+R AND +B GAIN A STEP; THE OTHERS MOVE AS A GOLD. YOU WILL BE ASKED.",
+      "WHAT YOU TAKE CHANGES SIDES. TAP IT IN YOUR HAND, THEN AN EMPTY SQUARE. "
+      "NO TWO UNPROMOTED PAWNS ON ONE FILE, AND NO MATE BY A DROPPED PAWN.",
+      "CHECKMATE THE KING. HAVING NO LEGAL MOVE LOSES. "
+      "THE SAME POSITION FOUR TIMES IS A DRAW.",
+  };
+  fui::TextStyle cap;
+  cap.font = toybox::kUiFont;
+  cap.align = fui::TextAlign::Center;
+  cap.maxLines = 9;
+  const int16_t capTop = static_cast<int16_t>(body.y + 76);
+  screen.target().text(fui::makeRect(body.x, capTop, body.width, static_cast<int16_t>(dotY - 50 - capTop)),
+                       kLines[page], cap);
+}
+
+}  // namespace
+
+void buildHowTo(toybox::Screen& screen, const HowToModel& model) { doBuildHowTo(screen, model); }
+
+void buildBoard(toybox::Screen& screen, const BoardModel& model) {
+  fui::HeaderProps header;
+  header.title = "SHOGI";
+  header.borderEdges = fui::EdgesNone;
+  toybox::headerBand(screen, header);
+
+  const fui::DeviceContext device = screen.device();
+  const uint8_t top = sh::other(model.seat);
+
+  // The capsule, or the promotion question in its place.
+  if (model.askPromotion) {
+    fui::ButtonProps promote;
+    promote.label = "PROMOTE";
+    promote.action = ActionPromote;
+    screen.button(promote, promoteRect(device));
+    fui::ButtonProps keep;
+    keep.label = "DON'T";
+    keep.action = ActionKeep;
+    screen.button(keep, keepRect(device));
+  } else {
+    fui::ButtonProps status;
+    status.label = model.status;
+    status.action = fui::NO_ACTION;
+    status.borderEdges = fui::EdgesNone;
+    const fui::Rect capsule = fui::makeRect(boardLeft(device), capsuleTop(), kBoardSide, toybox::kPillHeight);
+    screen.button(status, model.opponentName != nullptr ? linkui::withOpponentFace(screen, capsule, model.opponentName)
+                                                        : capsule);
+  }
+
+  const fui::Rect frame = fui::makeRect(static_cast<int16_t>(boardLeft(device) - toybox::kBoardFrame),
+                                        static_cast<int16_t>(boardTop() - toybox::kBoardFrame),
+                                        static_cast<int16_t>(kBoardSide + toybox::kBoardFrame * 2),
+                                        static_cast<int16_t>(kBoardSide + toybox::kBoardFrame * 2));
+  screen.target().stroke(frame, fui::Paint::solid(fui::Color::Black), toybox::kBoardFrame);
+
+  // Grid lines rather than checkered squares: a shogi board is a plain grid.
+  for (int i = 1; i < sh::kFiles; ++i) {
+    const int16_t x = static_cast<int16_t>(boardLeft(device) + i * kSquare);
+    screen.target().fill(fui::makeRect(x, boardTop(), toybox::kHairline, kBoardSide),
+                         fui::Paint::solid(fui::Color::Black));
+    const int16_t y = static_cast<int16_t>(boardTop() + i * kSquare);
+    screen.target().fill(fui::makeRect(boardLeft(device), y, kBoardSide, toybox::kHairline),
+                         fui::Paint::solid(fui::Color::Black));
+  }
+  // The promotion zones, as faint shading on the three far ranks of each side,
+  // so where promotion starts is something the board shows.
+  for (int rank = 0; rank < sh::kRanks; ++rank) {
+    if (rank > 2 && rank < 6) continue;
+    for (int file = 0; file < sh::kFiles; ++file) {
+      const fui::Rect box = squareRect(device, file, rank, model.seat);
+      if (model.board.cell[sh::indexOf(file, rank)] != 0) continue;
+      screen.target().fill(fui::makeRect(static_cast<int16_t>(box.x + kSquare / 2 - 1),
+                                         static_cast<int16_t>(box.y + kSquare / 2 - 1), 3, 3),
+                           fui::Paint::dither(fui::Color::DarkGray));
+    }
+  }
+
+  for (int rank = 0; rank < sh::kRanks; ++rank) {
+    for (int file = 0; file < sh::kFiles; ++file) {
+      const uint8_t cell = model.board.cell[sh::indexOf(file, rank)];
+      if (cell == 0) continue;
+      const fui::Rect box = squareRect(device, file, rank, model.seat);
+      const bool mineAtBottom = sh::ownerOf(cell) == model.seat;
+      drawPiece(screen, pieceBox(box), sh::typeOf(cell), mineAtBottom, !mineAtBottom, toybox::kUiCut, toybox::kUiFont);
+    }
+  }
+
+  drawHand(screen, device, model.board, top, false, static_cast<uint8_t>(sh::None));
+  drawHand(screen, device, model.board, model.seat, true,
+           model.pick.fromHand() ? model.pick.drop : static_cast<uint8_t>(sh::None));
+
+  // The last move's landing square, so the reply is findable after the panel
+  // refreshes. Drawn after the pieces: a decoration outside its own cell needs
+  // its own pass.
+  if (model.lastTo < sh::kCells) {
+    const fui::Rect box = squareRect(device, sh::fileOf(model.lastTo), sh::rankOf(model.lastTo), model.seat);
+    toybox::bracket(screen, box, 10, 3);
+  }
+
+  if (model.pick.any() && !model.pick.fromHand()) {
+    const fui::Rect box = squareRect(device, sh::fileOf(model.pick.from), sh::rankOf(model.pick.from), model.seat);
+    screen.target().stroke(
+        fui::makeRect(static_cast<int16_t>(box.x - toybox::kFrame), static_cast<int16_t>(box.y - toybox::kFrame),
+                      static_cast<int16_t>(box.width + toybox::kFrame * 2),
+                      static_cast<int16_t>(box.height + toybox::kFrame * 2)),
+        fui::Paint::solid(fui::Color::Black), toybox::kFrame);
+  }
+
+  for (int i = 0; i < model.targets.count; ++i) {
+    const int square = model.targets.to[i];
+    const fui::Rect box = squareRect(device, sh::fileOf(square), sh::rankOf(square), model.seat);
+    if (model.targets.capture[i]) {
+      toybox::bracket(screen, box, 16, 4);
+    } else {
+      // A ring for a landing that may promote, a dot for one that may not.
+      if (model.targets.promotion[i] != sh::Promotion::None) {
+        toybox::ring(screen, static_cast<int16_t>(box.x + kSquare / 2), static_cast<int16_t>(box.y + kSquare / 2), 10,
+                     3, fui::Color::Black, fui::Color::White);
+      } else {
+        toybox::disc(screen, static_cast<int16_t>(box.x + kSquare / 2), static_cast<int16_t>(box.y + kSquare / 2), 8,
+                     fui::Color::Black);
+      }
+    }
+  }
+}
+
+void buildResult(toybox::Screen& screen, const ResultModel& model) {
+  fui::HeaderProps header;
+  header.title = model.title;
+  header.borderEdges = fui::EdgesNone;
+  toybox::headerBand(screen, header);
+  screen.insetContent(fui::Insets{toybox::kGutter * 3, toybox::kMargin, toybox::kMargin, toybox::kMargin});
+
+  fui::ButtonProps done;
+  done.label = "DONE";
+  done.action = ActionDone;
+  screen.button(done, screen.takeBottom(toybox::kPillHeight, toybox::kGutter));
+
+  fui::ButtonProps again;
+  again.label = "PLAY AGAIN";
+  again.action = ActionAgain;
+  screen.button(again, screen.takeBottom(toybox::kPillHeight, toybox::kGutter));
+
+  const fui::Rect area = screen.body();
+  if (model.reason != nullptr) {
+    fui::TextStyle big;
+    big.font = toybox::kDisplayFont;
+    big.align = fui::TextAlign::Center;
+    big.maxLines = 2;
+    screen.target().text(fui::makeRect(area.x, static_cast<int16_t>(area.y + 40), area.width, 130), model.reason, big);
+  }
+  char line[32];
+  std::snprintf(line, sizeof(line), "%d MOVES", model.plies);
+  fui::TextStyle body;
+  body.font = toybox::kUiFont;
+  body.align = fui::TextAlign::Center;
+  screen.target().text(fui::makeRect(area.x, static_cast<int16_t>(area.y + 190), area.width, 42), line, body);
+}
+
+}  // namespace shogiui
diff --git a/src/apps_local/shogi/ShogiScreens.h b/src/apps_local/shogi/ShogiScreens.h
new file mode 100644
index 00000000..a109ce2b
--- /dev/null
+++ b/src/apps_local/shogi/ShogiScreens.h
@@ -0,0 +1,91 @@
+#pragma once
+
+// Shogi on screen. Freestanding builders over plain models: no renderer, no
+// Activity, no storage, so host-tests/ui can build every screen against a fake
+// target and assert on what it drew and what it made tappable.
+
+#include "../ui/ToyboxScreen.h"
+#include "ShogiCore.h"
+#include "ShogiFlow.h"
+
+namespace shogiui {
+
+namespace fui = freeink::ui;
+
+enum : fui::ActionId {
+  ActionMenuRow = 1,
+  ActionHowToNext = 2,
+  ActionAgain = 3,
+  ActionDone = 4,
+  ActionPromote = 5,
+  ActionKeep = 6,
+};
+
+// Row identities. The menu shows CONTINUE only when there is a game to resume,
+// so a row's action value is its identity rather than its position.
+enum class MenuRow : int { Continue = 0, Computer, Friend, Nearby, HowTo, Count };
+
+struct MenuModel {
+  bool canContinue = false;
+  int wins = 0;
+  int losses = 0;
+  int draws = 0;
+  const char* nearbyName = nullptr;
+};
+
+struct HowToModel {
+  int page = 0;
+};
+
+struct BoardModel {
+  shogi::Board board{};
+  // The side drawn at the bottom. Its pieces point up the screen and its hand
+  // is the strip under the board.
+  uint8_t seat = shogi::kSente;
+  shogi::Pick pick{};
+  shogi::Targets targets{};
+  uint8_t lastTo = shogi::kNoSquare;
+  // The capsule's words, chosen by the activity because only it knows whether
+  // the engine is thinking or a link match is waiting.
+  const char* status = "YOUR MOVE";
+  // A landing that may or may not promote has been tapped; the capsule becomes
+  // the question.
+  bool askPromotion = false;
+  const char* opponentName = nullptr;
+};
+
+struct ResultModel {
+  const char* title = "A DRAW";
+  const char* reason = nullptr;
+  int plies = 0;
+};
+
+// Board geometry, and its exact inverse. Eighty-one squares and fourteen hand
+// slots against a twenty-four slot interaction buffer, so all of them are
+// hit-tested arithmetically from the same functions that place the pixels.
+// Both take the seat: the board is drawn from the bottom player's side.
+fui::Rect squareRect(const fui::DeviceContext& device, int file, int rank, uint8_t seat);
+bool squareAt(const fui::DeviceContext& device, int x, int y, uint8_t seat, int& file, int& rank);
+
+// The hand strips. `bottom` is the strip under the board (the seat's own hand);
+// `slot` indexes shogi::kHandOrder.
+fui::Rect handSlotRect(const fui::DeviceContext& device, bool bottom, int slot);
+bool handSlotAt(const fui::DeviceContext& device, int x, int y, bool& bottom, int& slot);
+
+// The two promotion answers, side by side where the status capsule sits.
+fui::Rect promoteRect(const fui::DeviceContext& device);
+fui::Rect keepRect(const fui::DeviceContext& device);
+
+void buildMenu(toybox::Screen& screen, const MenuModel& model);
+void buildHowTo(toybox::Screen& screen, const HowToModel& model);
+void buildBoard(toybox::Screen& screen, const BoardModel& model);
+void buildResult(toybox::Screen& screen, const ResultModel& model);
+
+int howToPages();
+
+// The letter a piece wears: "P", "R", "+P", "+R" and so on. Western shogi
+// notation, because the shipped cuts carry ASCII only and a kanji glyph would
+// simply not draw.
+const char* pieceLabel(uint8_t type);
+
+}  // namespace shogiui
